---
import "../styles/global.css";
import {
  getCanonicalUrl,
  getOgImageUrl,
  getSiteUrl,
  generateBreadcrumbSchema,
  generateWebApplicationSchema,
  type BreadcrumbItem,
} from "../utils/seo";

interface Props {
  title: string;
  description: string;
  /** Current page path without locale prefix, e.g. "/" or "/calculator" */
  path?: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  path = "/",
  image = "/og-image.png",
  noindex = false,
  breadcrumbs,
} = Astro.props;

const site = getSiteUrl();
const currentLocale = Astro.currentLocale ?? "en";
const canonicalURL = getCanonicalUrl(Astro.url.pathname);
const ogImageURL = getOgImageUrl(image);

// Build hreflang alternates
const enPath = path === "/" ? "/" : path;
const esPath = path === "/" ? "/es" : `/es${path}`;
const enAlternate = getCanonicalUrl(enPath);
const esAlternate = getCanonicalUrl(esPath);

// Generate structured data
const webAppSchema = generateWebApplicationSchema(canonicalURL, description, currentLocale);
const breadcrumbSchema = generateBreadcrumbSchema(Astro.url.pathname, currentLocale, breadcrumbs);
---

<!doctype html>
<html lang={currentLocale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DepositRescue" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Language Alternates -->
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="es" href={esAlternate} />
    <link rel="alternate" hreflang="x-default" href={enAlternate} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="DepositRescue" />
    <meta property="og:locale" content={currentLocale === "es" ? "es_US" : "en_US"} />
    <meta property="og:locale:alternate" content={currentLocale === "es" ? "en_US" : "es_US"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Schema.org JSON-LD (WebApplication & BreadcrumbList) -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <meta name="generator" content={Astro.generator} />

    <!-- Additional head elements / Schema JSON-LD slot -->
    <slot name="head" />
  </head>

  <body class="min-h-dvh bg-canvas text-text-primary font-sans antialiased flex flex-col">
    <!-- ─── Header ──────────────────────────────────── -->
    <header class="sticky top-0 z-50 w-full border-b border-border bg-canvas/80 backdrop-blur-lg">
      <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <!-- Logo -->
        <a href={currentLocale === "es" ? "/es" : "/"} class="flex items-center gap-2 transition-opacity duration-150 hover:opacity-80">
          <!-- Balance scale icon (SVG) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-text-secondary" aria-hidden="true">
            <path d="M12 3v18" />
            <path d="M3 7l3 5h6l3-5" />
            <path d="M15 7l3 5h6l-3-5" />
            <path d="M6 12a3 3 0 0 1-3 0" />
            <path d="M21 12a3 3 0 0 1-3 0" />
            <circle cx="12" cy="3" r="1" />
          </svg>
          <span class="text-base font-semibold tracking-tight">DepositRescue</span>
        </a>

        <!-- Center links -->
        <div class="hidden items-center gap-6 sm:flex">
          <a
            href={currentLocale === "es" ? "/es/calculator" : "/calculator"}
            class="text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary"
          >
            {currentLocale === "es" ? "Calculadora" : "Deposit Calculator"}
          </a>
          <a
            href={currentLocale === "es" ? "/es/about" : "/about"}
            class="text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary"
          >
            {currentLocale === "es" ? "Sobre Nosotros" : "About Us"}
          </a>
          <a
            href={currentLocale === "es" ? "/es/contact" : "/contact"}
            class="text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary"
          >
            {currentLocale === "es" ? "Contacto" : "Contact"}
          </a>
        </div>

        <!-- Language toggle -->
        <div class="flex items-center gap-1 rounded-md border border-border bg-card p-0.5 text-sm font-medium">
          <a
            href={enPath}
            class:list={[
              "rounded px-2.5 py-1 transition-all duration-150 ease-out",
              currentLocale === "en"
                ? "bg-cta-bg text-cta-text"
                : "text-text-muted hover:text-text-primary",
            ]}
            aria-label="English"
          >
            EN
          </a>
          <a
            href={esPath}
            class:list={[
              "rounded px-2.5 py-1 transition-all duration-150 ease-out",
              currentLocale === "es"
                ? "bg-cta-bg text-cta-text"
                : "text-text-muted hover:text-text-primary",
            ]}
            aria-label="Español"
          >
            ES
          </a>
        </div>
      </nav>
    </header>

    <!-- ─── Main ────────────────────────────────────── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ─── Footer ──────────────────────────────────── -->
    <footer class="border-t border-border">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <!-- Legal disclaimer -->
        <p class="max-w-2xl text-xs leading-5 text-text-muted">
          {currentLocale === "es"
            ? "DepositRescue proporciona herramientas informativas de cálculo legal y preparación automatizada de documentos. No somos abogados ni un bufete de abogados y no ofrecemos representación legal. La información proporcionada no constituye asesoramiento legal formal."
            : "DepositRescue provides self-help legal calculation tools and automated document preparation. We are not an attorney or law firm and do not provide legal representation. The information provided does not constitute formal legal advice."}
        </p>

        <!-- Secondary links -->
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs text-text-muted">
          <a href={currentLocale === "es" ? "/es/about" : "/about"} class="transition-colors duration-150 hover:text-text-secondary">
            {currentLocale === "es" ? "Sobre Nosotros" : "About Us"}
          </a>
          <a href={currentLocale === "es" ? "/es/privacy" : "/privacy"} class="transition-colors duration-150 hover:text-text-secondary">
            {currentLocale === "es" ? "Política de Privacidad" : "Privacy Policy"}
          </a>
          <a href={currentLocale === "es" ? "/es/terms" : "/terms"} class="transition-colors duration-150 hover:text-text-secondary">
            {currentLocale === "es" ? "Términos y Condiciones" : "Terms & Conditions"}
          </a>
          <a href={currentLocale === "es" ? "/es/contact" : "/contact"} class="transition-colors duration-150 hover:text-text-secondary">
            {currentLocale === "es" ? "Contacto" : "Contact Us"}
          </a>
        </div>

        <p class="mt-6 text-xs text-text-muted">
          &copy; {new Date().getFullYear()} DepositRescue. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
