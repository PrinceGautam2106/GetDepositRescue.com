---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Current page path without locale prefix, e.g. "/" or "/calculator" */
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const site = Astro.site?.origin ?? "https://getdepositrescue.com";
const currentLocale = Astro.currentLocale ?? "en";
const canonicalURL = new URL(Astro.url.pathname, site).href;

// Build hreflang alternates
const enPath = path === "/" ? "/" : path;
const esPath = path === "/" ? "/es" : `/es${path}`;
---

<!doctype html>
<html lang={currentLocale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- i18n alternates -->
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="es" href={`${site}${esPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${enPath}`} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={currentLocale === "es" ? "es_US" : "en_US"} />
    <meta property="og:site_name" content="DepositRescue" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body class="min-h-dvh bg-canvas text-text-primary font-sans antialiased flex flex-col">
    <!-- ─── Header ──────────────────────────────────── -->
    <header class="sticky top-0 z-50 w-full border-b border-border bg-canvas/80 backdrop-blur-lg">
      <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <!-- Logo -->
        <a href={currentLocale === "es" ? "/es" : "/"} class="flex items-center gap-2 transition-opacity duration-150 hover:opacity-80">
          <!-- Balance scale icon (SVG) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-text-secondary" aria-hidden="true">
            <path d="M12 3v18" />
            <path d="M3 7l3 5h6l3-5" />
            <path d="M15 7l3 5h6l-3-5" />
            <path d="M6 12a3 3 0 0 1-3 0" />
            <path d="M21 12a3 3 0 0 1-3 0" />
            <circle cx="12" cy="3" r="1" />
          </svg>
          <span class="text-base font-semibold tracking-tight">DepositRescue</span>
        </a>

        <!-- Center links -->
        <div class="hidden items-center gap-6 sm:flex">
          <a
            href={currentLocale === "es" ? "/es/calculator" : "/calculator"}
            class="text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary"
          >
            {currentLocale === "es" ? "Calculadora" : "Deposit Calculator"}
          </a>
        </div>

        <!-- Language toggle -->
        <div class="flex items-center gap-1 rounded-md border border-border bg-card p-0.5 text-sm font-medium">
          <a
            href={enPath}
            class:list={[
              "rounded px-2.5 py-1 transition-all duration-150 ease-out",
              currentLocale === "en"
                ? "bg-cta-bg text-cta-text"
                : "text-text-muted hover:text-text-primary",
            ]}
            aria-label="English"
          >
            EN
          </a>
          <a
            href={esPath}
            class:list={[
              "rounded px-2.5 py-1 transition-all duration-150 ease-out",
              currentLocale === "es"
                ? "bg-cta-bg text-cta-text"
                : "text-text-muted hover:text-text-primary",
            ]}
            aria-label="Español"
          >
            ES
          </a>
        </div>
      </nav>
    </header>

    <!-- ─── Main ────────────────────────────────────── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ─── Footer ──────────────────────────────────── -->
    <footer class="border-t border-border">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <!-- Legal disclaimer -->
        <p class="max-w-2xl text-xs leading-5 text-text-muted">
          {currentLocale === "es"
            ? "DepositRescue proporciona herramientas informativas de cálculo legal y preparación automatizada de documentos. No somos abogados ni un bufete de abogados y no ofrecemos representación legal. La información proporcionada no constituye asesoramiento legal formal."
            : "DepositRescue provides self-help legal calculation tools and automated document preparation. We are not an attorney or law firm and do not provide legal representation. The information provided does not constitute formal legal advice."}
        </p>

        <!-- Secondary links -->
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs text-text-muted">
          <a href="#" class="transition-colors duration-150 hover:text-text-secondary">Privacy</a>
          <a href="#" class="transition-colors duration-150 hover:text-text-secondary">Terms</a>
          <a href="#" class="transition-colors duration-150 hover:text-text-secondary">Affiliate Disclosure</a>
          <a href="#" class="transition-colors duration-150 hover:text-text-secondary">Contact</a>
        </div>

        <p class="mt-6 text-xs text-text-muted/60">
          &copy; {new Date().getFullYear()} DepositRescue. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
