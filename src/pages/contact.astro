---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact DepositRescue — Tenant Support & Order Assistance",
  description: "Get in touch with DepositRescue for certified mail tracking support, legal calculation inquiries, or partnership opportunities.",
  url: "https://getdepositrescue.com/contact",
  mainEntity: {
    "@type": "Organization",
    name: "DepositRescue",
    url: "https://getdepositrescue.com",
    email: "support@getdepositrescue.com",
    contactPoint: {
      "@type": "ContactPoint",
      email: "support@getdepositrescue.com",
      contactType: "customer service",
      availableLanguage: ["English", "Spanish"],
    },
  },
};
---

<BaseLayout
  title="Contact Us — DepositRescue | Support & Certified Mail Assistance"
  description="Have questions about your security deposit calculation, demand letter, or USPS certified mail tracking? Reach our support team today."
  path="/contact"
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  </slot>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Left Column: Context & Direct Info -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs font-mono font-medium text-text-secondary">
            <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
            Tenant Support Team
          </span>
          <h1 class="mt-4 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
            Get in Touch
          </h1>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed">
            Whether you need help tracking a USPS Certified Mail order, have questions about your state&rsquo;s statutory deadlines, or want to report an updated civil code, we&rsquo;re here to help.
          </p>
        </div>

        <div class="space-y-4 pt-2">
          <!-- Email card -->
          <div class="rounded-lg border border-border bg-card p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Direct Email</div>
            <a href="mailto:support@getdepositrescue.com" class="mt-1 block text-sm font-medium text-text-primary hover:text-emerald-400 transition-colors">
              support@getdepositrescue.com
            </a>
            <div class="mt-1 text-[11px] text-text-muted">Typical response time: under 24 business hours</div>
          </div>

          <!-- Postal support card -->
          <div class="rounded-lg border border-border bg-card p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">USPS Certified Mail Orders</div>
            <p class="mt-1 text-xs leading-relaxed text-text-secondary">
              If inquiring about an existing order, please include your Order ID (e.g. <code class="font-mono text-text-primary">ord_sim_...</code>) or 20-digit tracking number for instant lookup.
            </p>
          </div>

          <!-- Bilingual support card -->
          <div class="rounded-lg border border-border bg-card p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Bilingual Support</div>
            <p class="mt-1 text-xs text-text-secondary">
              Atención disponible en inglés y español / Support available in English &amp; Spanish.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="rounded-xl border border-border bg-card p-6 sm:p-8 shadow-sm">
          <h2 class="text-lg font-semibold text-text-primary">
            Send Us a Message
          </h2>
          <p class="mt-1 text-xs text-text-secondary">
            Fill out the form below and our tenant advocacy team will get back to you promptly.
          </p>

          <form id="contact-form" class="mt-6 space-y-4">
            <!-- Name Input -->
            <div>
              <label for="contact-name" class="block text-xs font-medium text-text-primary mb-1.5">
                Your Full Name <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                aria-label="Your Full Name"
                placeholder="Jane Doe"
                class="w-full rounded-md border border-border bg-canvas-alt px-3.5 py-2 text-xs text-text-primary focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
              />
            </div>

            <!-- Email Input -->
            <div>
              <label for="contact-email" class="block text-xs font-medium text-text-primary mb-1.5">
                Email Address <span class="text-danger">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                aria-label="Email Address"
                placeholder="jane@example.com"
                class="w-full rounded-md border border-border bg-canvas-alt px-3.5 py-2 text-xs text-text-primary focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
              />
            </div>

            <!-- Subject Selector -->
            <div>
              <label for="contact-subject" class="block text-xs font-medium text-text-primary mb-1.5">
                Topic / Subject <span class="text-danger">*</span>
              </label>
              <select
                id="contact-subject"
                name="subject"
                required
                aria-label="Contact Subject"
                class="w-full rounded-md border border-border bg-canvas-alt px-3.5 py-2 text-xs text-text-primary focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
              >
                <option value="mail-order">Certified Mail Order Status / Tracking</option>
                <option value="calculator">Deposit Calculation / State Statute Question</option>
                <option value="feedback">Legal Code Correction / Update Suggestion</option>
                <option value="partnership">Partnership or Media Inquiry</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <!-- Message Textarea -->
            <div>
              <label for="contact-message" class="block text-xs font-medium text-text-primary mb-1.5">
                How Can We Help? <span class="text-danger">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                aria-label="Your Message"
                placeholder="Describe your question or order details..."
                class="w-full rounded-md border border-border bg-canvas-alt px-3.5 py-2 text-xs text-text-primary focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
              ></textarea>
            </div>

            <!-- Submit button -->
            <button
              type="submit"
              id="contact-submit-btn"
              aria-label="Submit Contact Message"
              class="w-full flex items-center justify-center gap-2 rounded-lg bg-cta-bg py-2.5 text-xs font-semibold text-cta-text hover:bg-cta-hover active:scale-[0.99] transition-all shadow-sm"
            >
              <span id="contact-btn-text">Send Message</span>
              <span id="contact-spinner" class="hidden h-3.5 w-3.5 animate-spin rounded-full border-2 border-black border-t-transparent"></span>
            </button>

            <!-- Success message -->
            <div id="contact-success" class="hidden rounded-md border border-success/40 bg-success/10 p-3 text-xs text-success">
              Thank you! Your message has been received. Our team will review your inquiry and respond within 24 hours.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;
  const btnText = document.getElementById("contact-btn-text");
  const spinner = document.getElementById("contact-spinner");
  const successBox = document.getElementById("contact-success");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !btnText || !spinner || !successBox) return;

    submitBtn.disabled = true;
    btnText.textContent = "Sending...";
    spinner.classList.remove("hidden");

    // Realistic client feedback delay
    await new Promise((r) => setTimeout(r, 600));

    spinner.classList.add("hidden");
    btnText.textContent = "Sent!";
    form.reset();
    successBox.classList.remove("hidden");
  });
</script>
