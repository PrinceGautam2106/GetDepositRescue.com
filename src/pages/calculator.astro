---
import BaseLayout from "../layouts/BaseLayout.astro";
import DepositWizard from "../components/calculator/DepositWizard.astro";
---

<BaseLayout
  title="Deposit Recovery Calculator — DepositRescue"
  description="Calculate your security deposit penalty, identify statutory violations, and generate a legal demand letter in minutes. Free for all 50 US states."
  path="/calculator"
>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:py-16">
    <!-- Page header -->
    <div class="mb-10 text-center">
      <span class="mb-3 inline-flex items-center rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-text-secondary">
        <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        Free Legal Calculator
      </span>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Deposit Recovery Calculator
      </h1>
      <p class="mt-3 text-sm text-text-secondary">
        Answer a few questions. We'll calculate your claim, detect violations, and draft your demand letter.
      </p>
    </div>

    <!-- Calculator wizard -->
    <DepositWizard locale="en" />
  </section>
</BaseLayout>
