---
import BaseLayout from "../layouts/BaseLayout.astro";
import DepositWizard from "../components/calculator/DepositWizard.astro";
import TrustSignals from "../components/TrustSignals.astro";
---

<BaseLayout
  title="Deposit Recovery Calculator — DepositRescue"
  description="Calculate your security deposit penalty, identify statutory violations, and generate a legal demand letter in minutes. Free for all 50 US states."
  path="/calculator"
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:py-16">
    <!-- Page header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1 text-xs font-medium text-text-secondary shadow-xs">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
        Statutory Rules Audited for 2026 Compliance under US Landlord-Tenant Codes
      </span>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
        Deposit Recovery Calculator
      </h1>
      <p class="mt-3 text-sm text-text-secondary leading-relaxed">
        Answer a few questions. We'll calculate your claim, detect violations, and draft your demand letter.
      </p>
    </div>

    <!-- Calculator wizard -->
    <div class="mx-auto max-w-2xl">
      <DepositWizard locale="en" />
    </div>

    <!-- E-E-A-T Trust & Methodology -->
    <TrustSignals locale="en" class="mt-16" />
  </section>
</BaseLayout>
