---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DepositWizard from "../../components/calculator/DepositWizard.astro";
---

<BaseLayout
  title="Calculadora de Recuperación de Depósito — DepositRescue"
  description="Calcule la multa de su depósito de seguridad, identifique violaciones legales y genere una carta de demanda en minutos. Gratis para los 50 estados de EE.UU."
  path="/calculator"
>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:py-16">
    <!-- Page header -->
    <div class="mb-10 text-center">
      <span class="mb-3 inline-flex items-center rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-text-secondary">
        <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        Calculadora Legal Gratuita
      </span>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Calculadora de Recuperación de Depósito
      </h1>
      <p class="mt-3 text-sm text-text-secondary">
        Responda algunas preguntas. Calcularemos su reclamación, detectaremos violaciones y redactaremos su carta de demanda.
      </p>
    </div>

    <!-- Calculator wizard -->
    <DepositWizard locale="es" />
  </section>
</BaseLayout>
