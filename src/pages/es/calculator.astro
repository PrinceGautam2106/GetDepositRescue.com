---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DepositWizard from "../../components/calculator/DepositWizard.astro";
import TrustSignals from "../../components/TrustSignals.astro";
---

<BaseLayout
  title="Calculadora de Recuperación de Depósito — DepositRescue"
  description="Calcule la multa de su depósito de seguridad, identifique violaciones legales y genere una carta de demanda en minutos. Gratis para los 50 estados de EE.UU."
  path="/calculator"
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:py-16">
    <!-- Page header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1 text-xs font-medium text-text-secondary shadow-xs">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
        Statutory Rules Audited for 2026 Compliance under US Landlord-Tenant Codes
      </span>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
        Calculadora de Recuperación de Depósito
      </h1>
      <p class="mt-3 text-sm text-text-secondary leading-relaxed">
        Responda algunas preguntas. Calcularemos su reclamación, detectaremos violaciones y redactaremos su carta de demanda.
      </p>
    </div>

    <!-- Calculator wizard -->
    <div class="mx-auto max-w-2xl">
      <DepositWizard locale="es" />
    </div>

    <!-- E-E-A-T Trust & Methodology -->
    <TrustSignals locale="es" class="mt-16" />
  </section>
</BaseLayout>
