---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="500: Error del Servidor — DepositRescue"
  description="Ocurrió un error inesperado en el servidor al procesar su solicitud legal estatutaria en DepositRescue."
  path="/500"
  noindex={true}
>
  <div class="relative flex min-h-[calc(100vh-14rem)] items-center justify-center px-4 py-16 sm:py-24">
    <!-- Resplandor sutil de fondo -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden">
      <div class="h-96 w-96 rounded-full bg-danger/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto w-full max-w-xl text-center">
      <!-- Placa de estado -->
      <div class="inline-flex items-center gap-2 rounded-full border border-danger/30 bg-danger/10 px-3.5 py-1 text-xs font-mono font-medium text-danger">
        <span class="h-1.5 w-1.5 rounded-full bg-danger animate-pulse"></span>
        ESTADO 500 &bull; ERROR DEL SERVIDOR
      </div>

      <!-- Icono de error -->
      <div class="mt-6 flex justify-center">
        <div class="relative flex h-24 w-24 items-center justify-center rounded-2xl border border-border bg-card shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-12 w-12 text-danger">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
          </svg>
        </div>
      </div>

      <!-- Titular Principal -->
      <h1 class="mt-6 font-mono text-5xl font-extrabold tracking-tight text-text-primary sm:text-6xl">
        500
      </h1>
      <h2 class="mt-2 text-xl font-bold tracking-tight text-text-primary sm:text-2xl">
        Procesamiento Estatutario Interrumpido
      </h2>

      <!-- Descripción -->
      <p class="mt-3 text-sm text-text-secondary leading-relaxed">
        Nuestro motor de cálculo y redacción de documentos legales experimentó una excepción inesperada del servidor. Nuestro equipo técnico ha sido notificado.
      </p>

      <!-- Botones de Acción -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          type="button"
          id="btn-retry-es"
          onclick="window.location.reload()"
          aria-label="Recargar Página"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cta-bg px-6 py-2.5 text-xs font-semibold text-cta-text transition-all duration-150 ease-out hover:bg-cta-hover active:scale-[0.99] shadow-sm sm:w-auto"
        >
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311V15a.75.75 0 0 1-1.5 0v-3.5a.75.75 0 0 1 .75-.75H8.5a.75.75 0 0 1 0 1.5H7.058l.164.163a4 4 0 0 0 6.703-1.795.75.75 0 0 1 1.387.562ZM4.688 8.576a5.5 5.5 0 0 1 9.201-2.466l.312.311V5a.75.75 0 0 1 1.5 0v3.5a.75.75 0 0 1-.75.75H11.5a.75.75 0 0 1 0-1.5h1.442l-.164-.163a4 4 0 0 0-6.703 1.795.75.75 0 0 1-1.387-.562Z" clip-rule="evenodd" />
          </svg>
          Recargar Página
        </button>

        <a
          href="/es"
          aria-label="Volver al Inicio"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 py-2.5 text-xs font-semibold text-text-primary transition-all duration-150 ease-out hover:border-border-hover hover:bg-canvas-alt active:scale-[0.99] sm:w-auto"
        >
          Volver al Inicio
        </a>

        <a
          href="/es/contact"
          aria-label="Reportar Incidente"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 py-2.5 text-xs font-semibold text-text-secondary transition-all duration-150 ease-out hover:border-border-hover hover:text-text-primary active:scale-[0.99] sm:w-auto"
        >
          Reportar Incidente
        </a>
      </div>

      <!-- Tarjeta de Diagnóstico -->
      <div class="mt-12 rounded-xl border border-border bg-card p-4 text-left font-mono text-xs text-text-muted">
        <div class="flex items-center justify-between border-b border-border pb-2 text-[10px] uppercase tracking-wider">
          <span>Diagnóstico de Estado del Servidor</span>
          <span class="text-danger">HTTP 500 INTERNAL_ERROR</span>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed">
          Si esta condición persiste mientras genera su carta de demanda certificada, comuníquese con <a href="mailto:support@getdepositrescue.com" class="text-text-primary underline">support@getdepositrescue.com</a> indicando la hora de su sesión.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
