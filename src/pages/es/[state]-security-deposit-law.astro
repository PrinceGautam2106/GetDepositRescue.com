---
/**
 * es/[state]-security-deposit-law.astro
 * Spanish programmatic SEO dynamic route generating state law landing pages
 * for all 50 states + DC at /es/[state]-security-deposit-law
 */
import { STATE_STATUTES, type StateStatute } from "../../data/stateStatutes";
import StateLawPage from "../../components/seo/StateLawPage.astro";

export function getStaticPaths() {
  return Object.keys(STATE_STATUTES).map((code) => ({
    params: { state: code.toLowerCase() },
    props: { statute: STATE_STATUTES[code], lang: "es" as const },
  }));
}

interface Props {
  statute: StateStatute;
  lang: "es";
}

const { statute, lang } = Astro.props;
---

<StateLawPage statute={statute} lang={lang} />
