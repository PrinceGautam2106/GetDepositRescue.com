---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404: Evidencia No Encontrada — DepositRescue"
  description="La guía legal, cálculo de depósito o documento solicitado no fue encontrado en DepositRescue."
  path="/404"
  noindex={true}
>
  <div class="relative flex min-h-[calc(100vh-14rem)] items-center justify-center px-4 py-16 sm:py-24">
    <!-- Subtle background radial glow -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden">
      <div class="h-96 w-96 rounded-full bg-danger/5 blur-3xl"></div>
    </div>

    <div class="relative mx-auto w-full max-w-xl text-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-danger/30 bg-danger/10 px-3.5 py-1 text-xs font-mono font-medium text-danger">
        <span class="h-1.5 w-1.5 rounded-full bg-danger animate-pulse"></span>
        ESTADO 404 &bull; EXPEDIENTE NO ENCONTRADO
      </div>

      <!-- Large Error Visual -->
      <div class="mt-6 flex justify-center">
        <div class="relative flex h-24 w-24 items-center justify-center rounded-2xl border border-border bg-card shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-12 w-12 text-text-muted">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m-9-6 3 5h6l3-5m-9-6 3-5h6l3 5m-9 6a3 3 0 0 1-3 0m15 0a3 3 0 0 1-3 0" />
          </svg>
          <span class="absolute -bottom-2 -right-2 flex h-7 w-7 items-center justify-center rounded-full border border-border bg-canvas text-xs font-mono font-bold text-danger">
            !
          </span>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="mt-6 font-mono text-5xl font-extrabold tracking-tight text-text-primary sm:text-6xl">
        404
      </h1>
      <h2 class="mt-2 text-xl font-bold tracking-tight text-text-primary sm:text-2xl">
        Expediente o Página No Localizada
      </h2>

      <!-- Description -->
      <p class="mt-3 text-sm text-text-secondary leading-relaxed">
        El artículo legal, cálculo de reclamación o guía estatal que solicitó no existe, fue archivado o se ha trasladado a una nueva jurisdicción.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/es"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cta-bg px-6 py-2.5 text-xs font-semibold text-cta-text transition-all duration-150 ease-out hover:bg-cta-hover active:scale-[0.99] shadow-sm sm:w-auto"
        >
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 17 11h-1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6H3a1 1 0 0 1-.707-1.707l7-7Z" clip-rule="evenodd" />
          </svg>
          Volver al Inicio
        </a>

        <a
          href="/es/calculator"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 py-2.5 text-xs font-semibold text-text-primary transition-all duration-150 ease-out hover:border-border-hover hover:bg-canvas-alt active:scale-[0.99] sm:w-auto"
        >
          <svg class="h-4 w-4 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M6 2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H6Zm1 2a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H7Zm6 7a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Zm-3 3a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H10Zm-4 0a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H6Zm0-3a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H6Zm4 0a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H10Zm-4-3a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H6Zm4 0a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H10Zm3 0a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2H13Z" clip-rule="evenodd" />
          </svg>
          Calcular Depósito de Renta
        </a>
      </div>

      <!-- Quick Directory of Helpful Links -->
      <div class="mt-12 rounded-xl border border-border bg-card p-4 text-left">
        <div class="text-[11px] font-mono uppercase tracking-wider text-text-muted">
          Leyes Populares Sugeridas
        </div>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 text-xs">
          <a href="/es/ca-security-deposit-law" class="flex items-center justify-between rounded p-2 text-text-secondary hover:bg-canvas-alt hover:text-text-primary transition-colors">
            <span>Ley de Depósito en California</span>
            <span class="font-mono text-text-muted">&rarr;</span>
          </a>
          <a href="/es/tx-security-deposit-law" class="flex items-center justify-between rounded p-2 text-text-secondary hover:bg-canvas-alt hover:text-text-primary transition-colors">
            <span>Ley de Depósito en Texas</span>
            <span class="font-mono text-text-muted">&rarr;</span>
          </a>
          <a href="/es/ny-security-deposit-law" class="flex items-center justify-between rounded p-2 text-text-secondary hover:bg-canvas-alt hover:text-text-primary transition-colors">
            <span>Ley de Depósito en Nueva York</span>
            <span class="font-mono text-text-muted">&rarr;</span>
          </a>
          <a href="/es/contact" class="flex items-center justify-between rounded p-2 text-text-secondary hover:bg-canvas-alt hover:text-text-primary transition-colors">
            <span>Contactar al Equipo de Soporte</span>
            <span class="font-mono text-text-muted">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
