---
/**
 * AdBanner.astro
 * CLS-Safe Responsive Display Ad Container for Google AdSense & Mediavine.
 *
 * Designed with strict inline CSS min-height and reserved container dimensions
 * to ensure zero Cumulative Layout Shift (CLS < 0.05) across mobile and desktop.
 *
 * Supported Sizes:
 * - Desktop: 728x90 or 970x250
 * - Mobile: 300x250 or 320x100
 */

interface Props {
  slotId?: string;
  desktopSize?: "728x90" | "970x250";
  mobileSize?: "300x250" | "320x100";
  locale?: "en" | "es";
  class?: string;
}

const {
  slotId = "dr-responsive-banner",
  desktopSize = "728x90",
  mobileSize = "300x250",
  locale = "en",
  class: className = "",
} = Astro.props;

const isEs = locale === "es";

// Compute exact pixel dimensions
const [deskW, deskH] = desktopSize.split("x").map(Number);
const [mobW, mobH] = mobileSize.split("x").map(Number);

// Unique identifier for scoped CSS isolation
const bannerId = `ad-banner-${slotId.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<aside
  class={`cls-ad-container mx-auto my-10 w-full flex flex-col items-center justify-center ${className}`}
  aria-label={isEs ? "Espacio publicitario patrocinado" : "Sponsored advertisement"}
>
  <!-- Disclaimer label required by Google AdSense & IAB standards -->
  <span class="mb-1.5 text-[10px] font-mono uppercase tracking-widest text-text-muted/60 select-none">
    {isEs ? "Publicidad Patrocinada" : "Advertisement"}
  </span>

  <!--
    Strict inline min-height & background reservation for zero CLS (CLS < 0.05).
    Pre-allocates exact layout box before third-party ad scripts inject iframe content.
  -->
  <div
    id={bannerId}
    class="ad-banner-slot relative flex items-center justify-center overflow-hidden rounded-lg border border-border/70 bg-[#0e0e12] transition-colors"
    style={`min-height: ${mobH}px; background-color: #0e0e12;`}
    data-slot-id={slotId}
    data-desktop-size={desktopSize}
    data-mobile-size={mobileSize}
  >
    <!-- Ad slot container target for AdSense / Mediavine integration -->
    <ins
      class="adsbygoogle block w-full text-center"
      style="display:block"
      data-ad-client="ca-pub-SIMULATED"
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>

    <!-- Subtle Fallback Placeholder (Retains layout space if ads blocked or loading) -->
    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center p-3 select-none">
      <div class="flex items-center gap-1.5 text-[11px] font-mono text-text-muted/40">
        <svg class="h-3.5 w-3.5 shrink-0 opacity-40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zm.75 4.75a.75.75 0 00-1.5 0v5.5a.75.75 0 001.5 0v-5.5zm-.75 8a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
        </svg>
        <span>DepositRescue Network Partner</span>
      </div>
      <span class="mt-1 text-[10px] text-text-muted/30 font-mono hidden sm:inline">
        {deskW}×{deskH} Desktop &bull; {mobW}×{mobH} Mobile (CLS-Safe Resized)
      </span>
    </div>
  </div>
</aside>

<style define:vars={{ mobW, mobH, deskW, deskH }}>
  .ad-banner-slot {
    width: 100%;
    max-width: var(--mobW) * 1px;
    min-height: var(--mobH) * 1px;
    contain: layout size style;
  }

  @media (min-width: 768px) {
    .ad-banner-slot {
      max-width: var(--deskW) * 1px;
      min-height: var(--deskH) * 1px !important;
    }
  }
</style>
