---
/**
 * PartnerPerks.astro
 * Sleek 2-Card Affiliate Block for Tenant Lifecycle Protection.
 *
 * Placed immediately below the calculator results to offer tenants
 * moving solutions and renters insurance protection for their next lease.
 * Styled in the dark Vercel-inspired legal-tech aesthetic from DESIGN.md.
 */

interface Props {
  locale?: "en" | "es";
  class?: string;
}

const { locale = "en", class: className = "" } = Astro.props;
const isEs = locale === "es";

const perks = [
  {
    id: "moving-storage",
    badge: isEs ? "Mudanza y Almacenamiento" : "Moving & Storage",
    badgeColor: "border-purple-500/30 bg-purple-500/10 text-purple-400",
    partner: "PODS / U-Pack",
    title: isEs
      ? "¿Mudándose a un nuevo lugar? Obtenga cotizaciones instantáneas de almacenamiento y mudanza."
      : "Moving to a new place? Get instant quotes on moving containers & storage.",
    description: isEs
      ? "Compare contenedores de mudanza portátiles, camiones de carga y bodegas seguras con tarifas preferenciales para inquilinos."
      : "Compare top-rated portable moving containers, professional trucks, and secure storage units with upfront pricing for your next lease.",
    cta: isEs ? "Cotizar Mudanza Gratis →" : "Get Free Moving Quotes →",
    href: "https://www.pods.com/?utm_source=depositrescue&utm_medium=affiliate&utm_campaign=deposit_recovery",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75" />`,
  },
  {
    id: "renters-insurance",
    badge: isEs ? "Protección de Depósito" : "Deposit Protection",
    badgeColor: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    partner: "Lemonade / Policygenius",
    title: isEs
      ? "Proteja su próximo depósito: Seguro de inquilinos desde $5/mes."
      : "Protect your next deposit: Renters insurance starting at $5/month.",
    description: isEs
      ? "Cobertura integral de responsabilidad civil de $100k que protege contra reclamos injustos de daños y disputas de depósito."
      : "Shield yourself against wrongful landlord property claims, liability, and move-out disputes with $100k coverage in 90 seconds.",
    cta: isEs ? "Asegurar desde $5/mes →" : "Get Insured from $5/mo →",
    href: "https://www.lemonade.com/renters?utm_source=depositrescue&utm_medium=affiliate&utm_campaign=deposit_recovery",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />`,
  },
];
---

<div class={`w-full mt-6 mb-2 ${className}`}>
  <!-- Module Header -->
  <div class="mb-3.5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-text-primary">
        {isEs ? "Recursos Recomendados para Inquilinos" : "Tenant Next-Step Resources"}
      </h3>
    </div>
    <span class="text-[10px] uppercase font-mono tracking-wider text-text-muted">
      {isEs ? "Socios Verificados" : "Verified Partners"}
    </span>
  </div>

  <!-- 2-Card Sleek Grid -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {perks.map((perk) => (
      <div class="group relative flex flex-col justify-between rounded-xl border border-border bg-[#121215] p-5 transition-all duration-150 ease-out hover:border-zinc-700 hover:bg-[#15151a]">
        <div>
          <!-- Header: Badge & Partner -->
          <div class="flex items-center justify-between mb-3">
            <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-mono font-medium ${perk.badgeColor}`}>
              {perk.badge}
            </span>
            <span class="text-[11px] font-mono text-text-muted">
              {perk.partner}
            </span>
          </div>

          <!-- Icon & Title -->
          <div class="flex items-start gap-3 mb-2.5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border bg-[#18181d] text-text-secondary group-hover:text-emerald-400 group-hover:border-zinc-600 transition-colors mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="h-4.5 w-4.5"
                set:html={perk.icon}
              />
            </div>
            <h4 class="text-sm font-semibold tracking-tight text-text-primary group-hover:text-white transition-colors leading-snug">
              {perk.title}
            </h4>
          </div>

          <!-- Description -->
          <p class="text-xs leading-relaxed text-text-secondary pl-11 mb-4">
            {perk.description}
          </p>
        </div>

        <!-- Action CTA -->
        <div class="pt-3 border-t border-border/60 flex items-center justify-between">
          <a
            href={perk.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="inline-flex items-center gap-1.5 rounded-lg border border-border-hover bg-card px-3.5 py-2 text-xs font-semibold text-text-primary transition-all duration-150 hover:bg-zinc-800 hover:border-zinc-500 hover:text-white focus:outline-none focus:ring-1 focus:ring-emerald-400"
          >
            <span>{perk.cta}</span>
          </a>
          <span class="text-[10px] font-mono text-text-muted">
            {isEs ? "Sin costo extra" : "Zero extra cost"}
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- Transparency Disclosure -->
  <p class="mt-2 text-right text-[10px] text-text-muted">
    {isEs
      ? "Aviso: DepositRescue puede recibir una comisión de referencia al contratar a través de nuestros enlaces de socios."
      : "Affiliate Disclosure: DepositRescue may earn a referral fee from verified partners at no additional cost to you."}
  </p>
</div>
