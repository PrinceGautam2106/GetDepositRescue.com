          >
            <span>{isEs ? "Rastrear en USPS.com →" : "Track on USPS.com →"}</span>
          </a>
          <button
            id="wz-modal-done"
            type="button"
            aria-label={isEs ? "Cerrar confirmación" : "Done"}
            class="inline-flex flex-1 items-center justify-center rounded-lg bg-cta-bg py-2.5 text-xs font-semibold text-cta-text hover:bg-cta-hover transition-colors"
          >
            {isEs ? "Cerrar Confirmación" : "Done"}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

