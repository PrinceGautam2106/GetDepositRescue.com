<!-- Island Styles: Flash Badge Keyframes & Glowing Recovery Border           -->
<!-- ═════════════════════════════════════════════════════════════════════════ -->
<style>
  @keyframes badge-flash {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.8);
      border-color: rgba(59, 130, 246, 1);
      transform: scale(0.99);
    }
    50% {
      box-shadow: 0 0 28px 6px rgba(59, 130, 246, 0.45);
      border-color: rgba(96, 165, 250, 1);
      transform: scale(1.008);
    }
    100% {
      box-shadow: 0 0 16px 2px rgba(59, 130, 246, 0.25);
      border-color: rgba(59, 130, 246, 0.8);
      transform: scale(1);
    }
  }

  .wz-flash-badge {
    animation: badge-flash 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media print {
    body * {
      visibility: hidden;
    }
    #wz-printable-letter, #wz-printable-letter * {
      visibility: visible;
    }
    #wz-printable-letter {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      margin: 0;
      padding: 32px;
      display: block !important;
      color: #000000 !important;
      background: #ffffff !important;
    }
  }
</style>

<!-- ═════════════════════════════════════════════════════════════════════════ -->
<!-- Client-Side Island Logic: Reactive Transitions, Statutes, & Export       -->
<!-- ═════════════════════════════════════════════════════════════════════════ -->
<script>
  import { calculateClaim, type CalculatorResult } from "../../utils/depositCalculator";
  import { getStatute } from "../../data/stateStatutes";
  import { processMailOrder, type CreateOrderRequest } from "../../pages/api/create-mail-order";

  // ── Elements & State ─────────────────────────────────────────────────────
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const wizard = $<HTMLDivElement>("deposit-wizard");
  const locale = (wizard?.dataset.locale ?? "en") as "en" | "es";
  const isEs = locale === "es";

  // Step containers & Progress controls
  const stepSections = document.querySelectorAll<HTMLElement>(".wz-step");
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".wz-tab-btn");
  const stepLabel = $<HTMLSpanElement>("wz-step-label");
  const stepPct = $<HTMLSpanElement>("wz-step-pct");

  // Navigation Buttons
  const btnBack = $<HTMLButtonElement>("wz-back");
  const btnNext = $<HTMLButtonElement>("wz-next");
  const btnRestart = $<HTMLButtonElement>("wz-restart");

  // Inputs
  const inputState = $<HTMLSelectElement>("wz-state");
  const inputMoveout = $<HTMLInputElement>("wz-moveout");
  const inputDeposit = $<HTMLInputElement>("wz-deposit");
  const inputReturned = $<HTMLInputElement>("wz-returned");
  const stateDetectedTag = $<HTMLSpanElement>("wz-state-detected-tag");
  const stateStatuteHint = $<HTMLParagraphElement>("wz-state-statute-hint");

  // Optional letter inputs
  const inputTenantName = $<HTMLInputElement>("wz-tenant-name");
  const inputLandlordName = $<HTMLInputElement>("wz-landlord-name");
  const inputPropertyAddr = $<HTMLInputElement>("wz-property-addr");

  // Step 3 Outputs
  const violationBadge = $<HTMLDivElement>("wz-violation-badge");
  const violationText = $<HTMLParagraphElement>("wz-violation-text");
  const violationSubtext = $<HTMLParagraphElement>("wz-violation-subtext");
  const noViolationBadge = $<HTMLDivElement>("wz-no-violation-badge");
  const daysEl = $<HTMLParagraphElement>("wz-days-elapsed");
  const daysStatus = $<HTMLSpanElement>("wz-days-status");
  const deadlineEl = $<HTMLParagraphElement>("wz-state-deadline");
  const statuteCodeLabel = $<HTMLSpanElement>("wz-statute-code-label");
  const violationsList = $<HTMLDivElement>("wz-violations-list");
  const violationsUl = $<HTMLUListElement>("wz-violations-ul");
  const owedEl = $<HTMLSpanElement>("wz-owed");
  const penaltyEl = $<HTMLSpanElement>("wz-penalty");
  const multiplierTag = $<HTMLSpanElement>("wz-multiplier-tag");
  const totalEl = $<HTMLParagraphElement>("wz-total");
  const claimsBadge = $<HTMLSpanElement>("wz-claims-badge");

  // Step 4 Outputs & Action buttons
  const letterPreview = $<HTMLDivElement>("wz-letter-preview");
  const printableLetter = $<HTMLDivElement>("wz-printable-letter");
  const btnDownloadPdf = $<HTMLButtonElement>("wz-btn-download-pdf");
  const btnPdfText = $<HTMLSpanElement>("wz-btn-pdf-text");
  const btnPdfSpinner = $<HTMLSpanElement>("wz-btn-pdf-spinner");
  const btnCertifiedMail = $<HTMLButtonElement>("wz-btn-certified-mail");

  // Lead capture gate modal elements
  const leadModal = $<HTMLDivElement>("wz-lead-modal");
  const leadModalClose = $<HTMLButtonElement>("wz-lead-modal-close");
  const leadNameInput = $<HTMLInputElement>("wz-lead-name");
  const leadEmailInput = $<HTMLInputElement>("wz-lead-email");
  const leadSubmitBtn = $<HTMLButtonElement>("wz-lead-submit");
  const leadBtnText = $<HTMLSpanElement>("wz-lead-btn-text");
  const leadSpinner = $<HTMLSpanElement>("wz-lead-spinner");
  const leadError = $<HTMLDivElement>("wz-lead-error");

  // Certified mail modal elements
  const certifiedModal = $<HTMLDivElement>("wz-certified-modal");
  const modalClose = $<HTMLButtonElement>("wz-modal-close");
  const modalSubmit = $<HTMLButtonElement>("wz-modal-submit");
  const modalFormScreen = $<HTMLDivElement>("wz-modal-form-screen");
  const modalSuccessScreen = $<HTMLDivElement>("wz-modal-success-screen");
  const modalError = $<HTMLDivElement>("wz-modal-error");
  const modalBtnText = $<HTMLSpanElement>("wz-modal-btn-text");
  const modalSpinner = $<HTMLSpanElement>("wz-modal-spinner");
  const modalDone = $<HTMLButtonElement>("wz-modal-done");

  const mailLandlordName = $<HTMLInputElement>("wz-mail-landlord-name");
  const mailLandlordStreet = $<HTMLInputElement>("wz-mail-landlord-street");
  const mailLandlordCity = $<HTMLInputElement>("wz-mail-landlord-city");
  const mailLandlordState = $<HTMLInputElement>("wz-mail-landlord-state");
  const mailLandlordZip = $<HTMLInputElement>("wz-mail-landlord-zip");

  const mailTenantName = $<HTMLInputElement>("wz-mail-tenant-name");
  const mailTenantStreet = $<HTMLInputElement>("wz-mail-tenant-street");
  const mailTenantCity = $<HTMLInputElement>("wz-mail-tenant-city");
  const mailTenantState = $<HTMLInputElement>("wz-mail-tenant-state");
  const mailTenantZip = $<HTMLInputElement>("wz-mail-tenant-zip");

  const confirmedTracking = $<HTMLSpanElement>("wz-confirmed-tracking");
  const confirmedDelivery = $<HTMLSpanElement>("wz-confirmed-delivery");
  const confirmedOrderId = $<HTMLSpanElement>("wz-confirmed-order-id");
  const trackingLink = $<HTMLAnchorElement>("wz-tracking-link");

  // Internal State
  let currentStep = 1;
  const TOTAL_STEPS = 4;
  let lastResult: CalculatorResult | null = null;

  // ── Currency & Date Formatters ───────────────────────────────────────────
  const fmtMoney = (n: number) =>
    new Intl.NumberFormat(isEs ? "es-US" : "en-US", {
      style: "currency",
      currency: "USD",
      minimumFractionDigits: 2,
    }).format(n);

  const fmtDate = (d: Date) =>
    new Intl.DateTimeFormat(isEs ? "es-US" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(d);

  // ── Auto-Detect State from Timezone ──────────────────────────────────────
  function autoDetectState(): string {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
      if (tz.includes("Los_Angeles") || tz.includes("Pacific")) return "CA";
      if (tz.includes("New_York") || tz.includes("Eastern")) return "NY";
      if (tz.includes("Chicago") || tz.includes("Central")) return "TX";
      if (tz.includes("Denver") || tz.includes("Mountain") || tz.includes("Phoenix")) return "CO";
    } catch {
      // fallback
    }
    return "CA";
  }

  // ── Step Navigation ──────────────────────────────────────────────────────
  function goToStep(step: number) {
    currentStep = step;

    // Show/hide step sections with zero layout shift
    stepSections.forEach((el) => {
      const s = Number(el.dataset.step);
      el.classList.toggle("hidden", s !== step);
    });

    // Update Stepper Tabs
    tabButtons.forEach((btn, index) => {
      const sNum = index + 1;
      const badge = btn.querySelector(".wz-tab-badge");
      const title = btn.querySelector(".wz-tab-title");
      const bar = btn.querySelector(".wz-tab-bar");

      if (sNum === step) {
        btn.classList.add("border-border-hover", "bg-card");
        btn.classList.remove("opacity-60");
        badge?.classList.add("bg-cta-bg", "text-cta-text");
        badge?.classList.remove("bg-border", "text-text-muted", "bg-blue-600", "text-white");
        title?.classList.add("text-text-primary");
        bar?.classList.add("bg-cta-bg");
        bar?.classList.remove("bg-border", "bg-blue-600");
      } else if (sNum < step) {
        btn.classList.remove("border-border-hover");
        btn.classList.remove("opacity-60");
        badge?.classList.add("bg-blue-600", "text-white");
        badge?.classList.remove("bg-cta-bg", "text-cta-text", "bg-border", "text-text-muted");
        title?.classList.remove("text-text-primary");
        bar?.classList.add("bg-blue-600");
        bar?.classList.remove("bg-cta-bg", "bg-border");
      } else {
        btn.classList.remove("border-border-hover");
        btn.classList.add("opacity-60");
        badge?.classList.add("bg-border", "text-text-muted");
        badge?.classList.remove("bg-cta-bg", "text-cta-text", "bg-blue-600", "text-white");
        title?.classList.remove("text-text-primary");
        bar?.classList.add("bg-border");
        bar?.classList.remove("bg-cta-bg", "bg-blue-600");
      }
    });

    // Progress percentage
    const pct = Math.round((step / TOTAL_STEPS) * 100);
    if (stepLabel) {
      stepLabel.textContent = isEs
        ? `Paso ${step} de ${TOTAL_STEPS}`
        : `Step ${step} of ${TOTAL_STEPS}`;
    }
    if (stepPct) {
      stepPct.textContent = `${pct}%`;
    }

    // Action button visibility
    btnBack.classList.toggle("hidden", step === 1);
    btnNext.classList.toggle("hidden", step === TOTAL_STEPS);
    btnRestart.classList.toggle("hidden", step !== TOTAL_STEPS);

    // Compute or render on step changes
    if (step === 3) {
      runCalculation();
    }
    if (step === 4) {
      renderDemandLetter();
    }

    // Ensure smooth view scroll
    wizard.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // ── Validation ───────────────────────────────────────────────────────────
  function validateCurrentStep(): boolean {
    if (currentStep === 1) {
      if (!inputState.value) {
        flashError(inputState);
        return false;
      }
      if (!inputMoveout.value) {
        flashError(inputMoveout);
        return false;
      }
      return true;
    }
    if (currentStep === 2) {
      const deposit = parseFloat(inputDeposit.value);
      if (isNaN(deposit) || deposit <= 0) {
        flashError(inputDeposit);
        return false;
      }
      return true;
    }
    return true;
  }

  function flashError(el: HTMLElement) {
    el.classList.add("!border-danger");
    el.focus();
    setTimeout(() => el.classList.remove("!border-danger"), 2000);
  }

  // ── Step 1 Hint Updater ──────────────────────────────────────────────────
  function updateStateHint() {
    const code = inputState.value;
    const stat = getStatute(code);
    if (stateStatuteHint && stat) {
      stateStatuteHint.textContent = isEs
        ? `Plazo legal de ${stat.deadlineDays} días según ${stat.legalCodeCitation}.`
        : `Statutory return deadline: ${stat.deadlineDays} days under ${stat.legalCodeCitation}.`;
    }
  }

  // ── Step 3: Run Instant Violation & Damage Assessment ────────────────────
  function runCalculation() {
    const stateCode = inputState.value;
    const moveOutDate = inputMoveout.value;
    const depositAmount = parseFloat(inputDeposit.value) || 0;
    const amountReturned = parseFloat(inputReturned.value) || 0;
    const disputedDeductions = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="wz-deduction"]:checked'),
    ).map((cb) => cb.value);

    const result = calculateClaim({
      stateCode,
      depositAmount,
      moveOutDate,
      amountReturned,
      disputedDeductions,
    });
    lastResult = result;

    // Timeline counters
    daysEl.textContent = String(result.daysElapsed);
    deadlineEl.textContent = `${result.statute.deadlineDays} ${isEs ? "Días" : "Days"}`;
    statuteCodeLabel.textContent = result.statute.legalCodeCitation;

    if (result.isPastDeadline) {
      daysEl.classList.add("text-danger");
      daysEl.classList.remove("text-text-primary");
      daysStatus.textContent = isEs
        ? `+${result.daysElapsed - result.statute.deadlineDays} días tarde`
        : `+${result.daysElapsed - result.statute.deadlineDays} days late`;
      daysStatus.className = "mt-1 inline-block text-[11px] font-mono text-danger font-semibold";
    } else {
      daysEl.classList.remove("text-danger");
      daysEl.classList.add("text-text-primary");
      daysStatus.textContent = isEs
        ? `${result.statute.deadlineDays - result.daysElapsed} días restantes`
        : `${result.statute.deadlineDays - result.daysElapsed} days remaining`;
      daysStatus.className = "mt-1 inline-block text-[11px] font-mono text-sky-400";
    }

    // Flash bold emerald badge if deadline violated
    if (result.isPastDeadline) {
      violationBadge.classList.remove("hidden");
      noViolationBadge.classList.add("hidden");

      // Multiplier string logic:
      // If penaltyMultiplier is 2, up to 3x total recovery or up to 2x penalty
      // Format: "Statutory Deadline Violated! Your landlord may owe you up to [3x / 2x] your deposit under [State Code]."
      const mult = result.statute.penaltyMultiplier;
      const multiplierDisplay = mult > 0 ? (mult === 2 ? "3x" : `${mult}x`) : (isEs ? "el 100%" : "full return");

      violationText.textContent = isEs
        ? `¡Plazo Legal Violado! Su arrendador puede deberle hasta ${multiplierDisplay} de su depósito bajo ${result.statute.legalCodeCitation}.`
        : `Statutory Deadline Violated! Your landlord may owe you up to ${multiplierDisplay} your deposit under ${result.statute.legalCodeCitation}.`;

      violationSubtext.textContent = isEs
        ? `El plazo legal de ${result.statute.deadlineDays} días expiró hace ${result.daysElapsed - result.statute.deadlineDays} días. El arrendador perdió el derecho legal a deducciones.`
        : `The ${result.statute.deadlineDays}-day legal window expired ${result.daysElapsed - result.statute.deadlineDays} days ago. The landlord has forfeited rights to withhold your funds.`;

      // Trigger flash animation
      violationBadge.classList.remove("wz-flash-badge");
      void violationBadge.offsetWidth; // reflow
      violationBadge.classList.add("wz-flash-badge");
    } else {
      violationBadge.classList.add("hidden");
      noViolationBadge.classList.remove("hidden");
    }

    // Violations list
    if (result.violationTypes.length > 0) {
      violationsList.classList.remove("hidden");
      violationsUl.innerHTML = result.violationTypes
        .map(
          (v) =>
            `<li class="flex items-start gap-2 text-xs sm:text-sm text-text-secondary">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
              <span>${v}</span>
            </li>`,
        )
        .join("");
    } else {
      violationsList.classList.add("hidden");
    }

    // Financial calculations comparison
    const penaltyOnly = result.statutoryPenaltyAmount - result.unreturnedAmount;
    owedEl.textContent = fmtMoney(result.unreturnedAmount);
    penaltyEl.textContent = `+${fmtMoney(penaltyOnly)}`;
    totalEl.textContent = fmtMoney(result.statutoryPenaltyAmount);

    if (result.statute.penaltyMultiplier > 0) {
      multiplierTag.textContent = `+${result.statute.penaltyMultiplier}x penalty`;
      multiplierTag.classList.remove("hidden");
    } else {
      multiplierTag.classList.add("hidden");
    }

    // Small Claims Eligibility Badge
    if (result.smallClaimsEligible) {
      claimsBadge.innerHTML = `
        <svg class="h-3.5 w-3.5 text-sky-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <span class="text-text-primary">${isEs ? "Elegible para Corte de Reclamos Menores" : "Eligible for Small Claims Court"}</span>
        <span class="text-text-muted">(${isEs ? "tope" : "cap"}: ${fmtMoney(result.statute.smallClaimsLimit)})</span>
      `;
      claimsBadge.className = "inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 px-3 py-1 text-xs font-medium text-sky-300";
    } else {
      claimsBadge.innerHTML = `
        <svg class="h-3.5 w-3.5 text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span class="text-danger">${isEs ? "Excede el Tope de Reclamos Menores" : "Exceeds Small Claims Limit"}</span>
        <span class="text-text-muted">(${isEs ? "tope" : "cap"}: ${fmtMoney(result.statute.smallClaimsLimit)})</span>
      `;
      claimsBadge.className = "inline-flex items-center gap-1.5 rounded-full border border-danger/30 bg-danger/10 px-3 py-1 text-xs font-medium text-danger";
    }
  }

  // ── Step 4: Demand Letter Generator ──────────────────────────────────────
  function renderDemandLetter() {
    if (!lastResult) return;
    const r = lastResult;
    const statute = r.statute;
    const today = fmtDate(new Date());
    const moveOutFormatted = fmtDate(new Date(inputMoveout.value));
    const originalDeposit = parseFloat(inputDeposit.value) || 0;
    const amountReturned = parseFloat(inputReturned.value) || 0;
    const penaltyOnly = r.statutoryPenaltyAmount - r.unreturnedAmount;

    // Names and addresses
    const tenantName = inputTenantName?.value.trim() || (isEs ? "[SU NOMBRE COMPLETO]" : "[YOUR FULL NAME]");
    const landlordName = inputLandlordName?.value.trim() || (isEs ? "[ARRENDADOR / ADMINISTRADOR]" : "[LANDLORD / MANAGEMENT CO.]");
    const propertyAddr = inputPropertyAddr?.value.trim() || (isEs ? "[DIRECCIÓN DE LA PROPIEDAD]" : "[RENTAL PROPERTY ADDRESS]");

    const letterHtml = `
      <!-- Demand Letter Header -->
      <div class="border-b border-border pb-3 font-mono text-xs">
        <div class="flex justify-between items-center text-text-muted">
          <span>${isEs ? "FECHA" : "DATE"}: ${today}</span>
          <span class="text-sky-400 font-semibold">${isEs ? "ENVÍO CERTIFICADO USPS" : "USPS CERTIFIED MAIL"}</span>
        </div>
        <div class="mt-2 text-text-secondary">
          <p><strong class="text-text-primary">${isEs ? "DE" : "FROM"}:</strong> ${tenantName}</p>
          <p><strong class="text-text-primary">${isEs ? "PARA" : "TO"}:</strong> ${landlordName}</p>
          <p><strong class="text-text-primary">${isEs ? "PROPIEDAD" : "PREMISES"}:</strong> ${propertyAddr}</p>
        </div>
      </div>

      <!-- Subject line -->
      <div class="font-bold text-text-primary pt-1 text-sm sm:text-base tracking-tight">
        ${isEs ? "RE: DEMANDA FORMAL DE DEVOLUCIÓN DE DEPÓSITO DE SEGURIDAD Y AVISO DE LITIGIO" : "RE: FORMAL DEMAND FOR RETURN OF SECURITY DEPOSIT & INTENT TO LITIGATE"}
      </div>

      <!-- Greeting & Notice -->
      <p>
        ${isEs ? `Estimado(a) ${landlordName}:` : `Dear ${landlordName}:`}
      </p>

      <p>
        ${isEs
          ? `Por medio de la presente, notifico formalmente la demanda de devolución de mi depósito de seguridad original por la suma de ${fmtMoney(originalDeposit)}, entregado en garantía para el inmueble en ${propertyAddr}. Entregué formalmente las llaves y desocupé la propiedad el ${moveOutFormatted}.`
          : `This letter serves as formal written demand for the immediate return of my security deposit originally paid in the amount of ${fmtMoney(originalDeposit)} for the residential property located at ${propertyAddr}. I vacated the premises and surrendered all keys on ${moveOutFormatted}.`}
      </p>

      <!-- Statutory Clause with Legal Citation -->
      <div class="rounded-lg border border-border bg-canvas p-4 text-xs font-mono leading-relaxed text-text-secondary">
        <p class="font-bold text-text-primary mb-1">
          ${isEs ? "CITA LEGAL Y VIOLACIÓN ESTATUTARIA:" : "STATUTORY LEGAL CITATION & VIOLATION:"}
        </p>
        <p>${statute.demandLetterStatutoryClause[locale]}</p>
      </div>

      <!-- Accounting Summary Table -->
      <div class="overflow-x-auto rounded-lg border border-border bg-card p-3 font-mono text-xs">
        <div class="font-bold text-text-primary mb-2">${isEs ? "LIQUIDACIÓN DE DAÑOS Y PERJUICIOS:" : "ACCOUNTING OF DAMAGES & MONETARY CLAIM:"}</div>
        <div class="space-y-1">
          <div class="flex justify-between py-0.5 border-b border-border/50">
            <span>${isEs ? "Depósito Original Pagado" : "Original Deposit Paid"}:</span>
            <span>${fmtMoney(originalDeposit)}</span>
          </div>
          <div class="flex justify-between py-0.5 border-b border-border/50">
            <span>${isEs ? "Monto Devuelto por Arrendador" : "Amount Returned by Landlord"}:</span>
            <span>${fmtMoney(amountReturned)}</span>
          </div>
          <div class="flex justify-between py-0.5 border-b border-border/50 text-text-primary font-medium">
            <span>${isEs ? "Saldo Retenido Ilegalmente" : "Unreturned Balance Owed"}:</span>
            <span>${fmtMoney(r.unreturnedAmount)}</span>
          </div>
          <div class="flex justify-between py-0.5 border-b border-border/50 text-sky-400 font-medium">
            <span>${isEs ? "Sanción Estatutaria por Retención Indebida" : "Statutory Bad-Faith Damages"}:</span>
            <span>+${fmtMoney(penaltyOnly)}</span>
          </div>
          <div class="flex justify-between pt-1.5 font-bold text-sm text-sky-300">
            <span>${isEs ? "TOTAL DEMANDADO EN CORTE" : "TOTAL COURT DEMAND TARGET"}:</span>
            <span>${fmtMoney(r.statutoryPenaltyAmount)}</span>
          </div>
        </div>
      </div>

      <!-- Formal 10-day notice & closing -->
      <p>
        ${isEs
          ? `Le concedo un plazo perentorio de diez (10) días hábiles contados a partir de la recepción de esta notificación para remitir un cheque certificado o transferencia por la cantidad total adeudada de ${fmtMoney(r.statutoryPenaltyAmount)}. En caso contrario, radicaré de inmediato la demanda correspondiente ante el tribunal competente, solicitando además los costos de radicación, honorarios legales y sanciones legales completas.`
          : `You are hereby granted ten (10) business days from the verified delivery of this letter to remit payment in the amount of ${fmtMoney(r.statutoryPenaltyAmount)}. Failure to comply will result in an immediate complaint filed in small claims court without further notice, seeking all statutory penalties, filing fees, and court costs allowable under law.`}
      </p>

      <div class="pt-2">
        <p class="font-medium text-text-primary">${isEs ? "Respetuosamente," : "Respectfully submitted,"}</p>
        <p class="mt-4 font-semibold text-text-primary underline decoration-border-hover">${tenantName}</p>
      </div>
    `;

    if (letterPreview) {
      letterPreview.innerHTML = letterHtml;
    }
    if (printableLetter) {
      printableLetter.innerHTML = letterHtml;
    }

    try {
      localStorage.setItem("dr_letter_html", letterHtml);
      localStorage.setItem("dr_claim_data", JSON.stringify({
        state: statute.stateName,
        stateCode: statute.stateCode,
        citation: statute.legalCodeCitation,
        deadlineDays: statute.deadlineDays,
        penaltyMultiplier: statute.penaltyMultiplier,
        smallClaimsLimit: statute.smallClaimsLimit,
        unreturnedAmount: r.unreturnedAmount,
        penaltyAmount: penaltyOnly,
        totalRecovery: r.statutoryPenaltyAmount,
        tenantName,
        landlordName,
        propertyAddr,
        date: today,
      }));
    } catch {
      // ignore storage quota error
    }
  }

  // ── Lead Capture Gate Handlers ───────────────────────────────────────────
  interface StoredLead {
    name: string;
    email: string;
    timestamp?: string;
  }

  function getStoredLead(): StoredLead | null {
    try {
      const raw = localStorage.getItem("dr_lead");
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed.email === "string" && parsed.email.includes("@")) {
        return parsed;
      }
    } catch {
      // ignore storage access errors
    }
    return null;
  }

  function openLeadModal() {
    if (leadError) leadError.classList.add("hidden");
    const stored = getStoredLead();
    if (stored) {
      if (leadNameInput && !leadNameInput.value) leadNameInput.value = stored.name;
      if (leadEmailInput && !leadEmailInput.value) leadEmailInput.value = stored.email;
    }
    leadModal?.classList.remove("hidden");
    leadModal?.classList.add("flex");
    leadNameInput?.focus();
  }

  function closeLeadModal() {
    leadModal?.classList.add("hidden");
    leadModal?.classList.remove("flex");
  }

  leadModalClose?.addEventListener("click", closeLeadModal);
  leadModal?.addEventListener("click", (e) => {
    if (e.target === leadModal) closeLeadModal();
  });

  leadSubmitBtn?.addEventListener("click", async () => {
    const name = leadNameInput?.value.trim() || "";
    const email = leadEmailInput?.value.trim().toLowerCase() || "";

    if (!name || name.length < 2) {
      if (leadError) {
        leadError.textContent = isEs ? "Por favor ingrese su nombre completo." : "Please enter your full legal name.";
        leadError.classList.remove("hidden");
      }
      leadNameInput?.focus();
      return;
    }

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (leadError) {
        leadError.textContent = isEs ? "Por favor ingrese un correo electrónico válido." : "Please enter a valid email address.";
        leadError.classList.remove("hidden");
      }
      leadEmailInput?.focus();
      return;
    }

    if (leadError) leadError.classList.add("hidden");
    if (leadSubmitBtn) leadSubmitBtn.disabled = true;
    if (leadSpinner) leadSpinner.classList.remove("hidden");

    // Persist lead locally to localStorage
    const leadPayload: StoredLead = { name, email, timestamp: new Date().toISOString() };
    try {
      localStorage.setItem("dr_lead", JSON.stringify(leadPayload));
    } catch {
      // ignore storage failure
    }

    // Auto-populate tenant names on Step 4 and Certified modal
    if (inputTenantName) inputTenantName.value = name;
    if (mailTenantName) mailTenantName.value = name;

    // Send lead to /api/leads endpoint
    try {
      await fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          email,
          stateCode: inputState?.value || "CA",
          totalClaimAmount: lastResult?.statutoryPenaltyAmount,
          statutoryPenalty: lastResult?.statutoryPenaltyAmount ? lastResult.statutoryPenaltyAmount - lastResult.unreturnedAmount : 0,
        }),
      });
    } catch {
      // Non-blocking
    } finally {
      if (leadSubmitBtn) leadSubmitBtn.disabled = false;
      if (leadSpinner) leadSpinner.classList.add("hidden");
      closeLeadModal();
      goToStep(4);
    }
  });

  // ── Download Plain Text / Print PDF Handler ──────────────────────────────
  btnDownloadPdf?.addEventListener("click", async () => {
    renderDemandLetter();
    const stored = getStoredLead();
    const tenantName = inputTenantName?.value.trim() || stored?.name || "";
    const tenantEmail = stored?.email || "";
    const landlordName = inputLandlordName?.value.trim() || "";
    const state = inputState?.value || "CA";
    const totalClaim = lastResult?.statutoryPenaltyAmount || 0;

    // UI Loading state
    if (btnDownloadPdf) btnDownloadPdf.disabled = true;
    if (btnPdfSpinner) btnPdfSpinner.classList.remove("hidden");
    if (btnPdfText) {
      btnPdfText.textContent = isEs ? "Iniciando descarga..." : "Preparing Download...";
    }

    try {
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          tier: "pdf",
          stateCode: state,
          tenantName,
          tenantEmail,
          landlordName,
          totalClaimAmount: totalClaim,
          letterContent: printableLetter?.innerText || letterPreview?.innerText || "",
          locale,
        }),
      });

      const lsPdfFallback = `https://getdepositrescue.lemonsqueezy.com/checkout/buy/848c89ea-e164-4b3e-b394-18fd1313bd2f?checkout[email]=${encodeURIComponent(tenantEmail)}&checkout[name]=${encodeURIComponent(tenantName)}`;

      if (response.ok) {
        const data = await response.json();
        if (data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
          return;
        }
        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
          return;
        }
      }
      window.location.href = lsPdfFallback;
    } catch {
      window.location.href = `https://getdepositrescue.lemonsqueezy.com/checkout/buy/848c89ea-e164-4b3e-b394-18fd1313bd2f?checkout[email]=${encodeURIComponent(tenantEmail)}&checkout[name]=${encodeURIComponent(tenantName)}`;
    } finally {
      if (btnDownloadPdf) btnDownloadPdf.disabled = false;
      if (btnPdfSpinner) btnPdfSpinner.classList.add("hidden");
      if (btnPdfText) {
        btnPdfText.textContent = isEs ? "Descargar PDF ($14.99)" : "Download PDF ($14.99)";
      }
    }
  });

  // ── Send Certified Mail Modal Handlers ────────────────────────────────────
  function resetCertifiedModal() {
    if (modalError) {
      modalError.classList.add("hidden");
      modalError.textContent = "";
    }
    if (modalFormScreen) modalFormScreen.classList.remove("hidden");
    if (modalSuccessScreen) modalSuccessScreen.classList.add("hidden");
    if (modalSubmit) modalSubmit.disabled = false;
    if (modalSpinner) modalSpinner.classList.add("hidden");
    if (modalBtnText) {
      modalBtnText.textContent = isEs
        ? "Despachar Correo Certificado ($29.99)"
        : "Dispatch Certified Mail ($29.99)";
    }
  }

  function prefillModalAddresses() {
    const stored = getStoredLead();
    if (inputLandlordName?.value.trim() && mailLandlordName && !mailLandlordName.value) {
      mailLandlordName.value = inputLandlordName.value.trim();
    }
    if (inputTenantName?.value.trim() && mailTenantName && !mailTenantName.value) {
      mailTenantName.value = inputTenantName.value.trim();
    } else if (stored?.name && mailTenantName && !mailTenantName.value) {
      mailTenantName.value = stored.name;
    }
    if (inputPropertyAddr?.value.trim() && mailLandlordStreet && !mailLandlordStreet.value) {
      mailLandlordStreet.value = inputPropertyAddr.value.trim();
    }
    if (inputState?.value) {
      if (mailLandlordState && !mailLandlordState.value) mailLandlordState.value = inputState.value;
      if (mailTenantState && !mailTenantState.value) mailTenantState.value = inputState.value;
    }
  }

  btnCertifiedMail?.addEventListener("click", () => {
    prefillModalAddresses();
    resetCertifiedModal();
    certifiedModal.classList.remove("hidden");
    certifiedModal.classList.add("flex");
  });

  const closeModal = () => {
    certifiedModal.classList.add("hidden");
    certifiedModal.classList.remove("flex");
  };

  modalClose?.addEventListener("click", closeModal);
  modalDone?.addEventListener("click", closeModal);

  certifiedModal?.addEventListener("click", (e) => {
    if (e.target === certifiedModal) {
      closeModal();
    }
  });

  modalSubmit?.addEventListener("click", async () => {
    // 1. Gather inputs
    const lName = mailLandlordName?.value.trim() || "";
    const lStreet = mailLandlordStreet?.value.trim() || "";
    const lCity = mailLandlordCity?.value.trim() || "";
    const lState = mailLandlordState?.value.trim().toUpperCase() || "";
    const lZip = mailLandlordZip?.value.trim() || "";

    const tName = mailTenantName?.value.trim() || "";
    const tStreet = mailTenantStreet?.value.trim() || "";
    const tCity = mailTenantCity?.value.trim() || "";
    const tState = mailTenantState?.value.trim().toUpperCase() || "";
    const tZip = mailTenantZip?.value.trim() || "";

    // 2. Validate
    const errors: string[] = [];
    if (!lName || lName.length < 2) errors.push(isEs ? "Nombre del arrendador requerido" : "Landlord name required");
    if (!lStreet || lStreet.length < 4) errors.push(isEs ? "Dirección del arrendador requerida" : "Landlord street address required");
    if (!lCity) errors.push(isEs ? "Ciudad del arrendador requerida" : "Landlord city required");
    if (!lState || lState.length !== 2) errors.push(isEs ? "Estado del arrendador (2 letras)" : "Landlord 2-letter state code required");
    if (!/^\d{5}(-\d{4})?$/.test(lZip)) errors.push(isEs ? "Código postal del arrendador inválido" : "Landlord 5-digit ZIP code required");

    if (!tName || tName.length < 2) errors.push(isEs ? "Su nombre legal requerido" : "Tenant legal name required");
    if (!tStreet || tStreet.length < 4) errors.push(isEs ? "Su dirección de remitente requerida" : "Tenant street address required");
    if (!tCity) errors.push(isEs ? "Su ciudad requerida" : "Tenant city required");
    if (!tState || tState.length !== 2) errors.push(isEs ? "Su estado (2 letras)" : "Tenant 2-letter state code required");
    if (!/^\d{5}(-\d{4})?$/.test(tZip)) errors.push(isEs ? "Su código postal inválido" : "Tenant 5-digit ZIP code required");

    if (errors.length > 0) {
      if (modalError) {
        modalError.textContent = errors.join(" • ");
        modalError.classList.remove("hidden");
      }
      return;
    }

    // 3. UI Loading state
    if (modalError) modalError.classList.add("hidden");
    if (modalSubmit) modalSubmit.disabled = true;
    if (modalSpinner) modalSpinner.classList.remove("hidden");
    if (modalBtnText) {
      modalBtnText.textContent = isEs
        ? "Procesando Orden USPS ($29.99)..."
        : "Processing USPS Order ($29.99)...";
    }

    try {
      const stored = getStoredLead();
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          tier: "mail",
          stateCode: lState || inputState?.value || "CA",
          tenantName: tName || stored?.name || "",
          tenantEmail: stored?.email || "",
          landlordName: lName,
          totalClaimAmount: lastResult?.statutoryPenaltyAmount,
          letterContent: printableLetter?.innerText || letterPreview?.innerText || "",
          locale,
        }),
      });

      const lsMailFallback = `https://getdepositrescue.lemonsqueezy.com/checkout/buy/b421d308-0ac9-4748-b0cd-79d482627366?checkout[email]=${encodeURIComponent(stored?.email || "")}&checkout[name]=${encodeURIComponent(tName || stored?.name || "")}`;

      if (response.ok) {
        const data = await response.json();
        if (data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
          return;
        }
        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
          return;
        }
      } else {
        window.location.href = lsMailFallback;
        return;
      }

      const orderPayload: CreateOrderRequest = {
        tenantAddress: {
          name: tName,
          addressLine1: tStreet,
          city: tCity,
          state: tState,
          zip: tZip,
        },
        landlordAddress: {
          name: lName,
          addressLine1: lStreet,
          city: lCity,
          state: lState,
          zip: lZip,
        },
        letterContent: printableLetter?.innerText || letterPreview?.innerText || "Formal Demand Letter for Return of Security Deposit",
        stateCode: inputState?.value || "CA",
        totalClaimAmount: lastResult?.statutoryPenaltyAmount,
      };

      const result = await processMailOrder(orderPayload);

      // If live Stripe session returned, redirect to checkout
      if (result.checkoutUrl) {
        window.location.href = result.checkoutUrl;
        return;
      }

      // Display Screen 2: Barcode & Tracking Confirmation
      if (confirmedTracking) confirmedTracking.textContent = result.trackingNumber;
      if (confirmedDelivery) confirmedDelivery.textContent = result.estimatedDeliveryDate;
      if (confirmedOrderId) confirmedOrderId.textContent = result.orderId;
      if (trackingLink) {
        const rawTracking = result.trackingNumber.replace(/\s+/g, "");
        trackingLink.href = result.proofDocumentUrl || `https://tools.usps.com/go/TrackConfirmAction?tLabels=${rawTracking}`;
      }

      if (modalFormScreen) modalFormScreen.classList.add("hidden");
      if (modalSuccessScreen) modalSuccessScreen.classList.remove("hidden");
    } catch (err) {
      if (modalError) {
        modalError.textContent = err instanceof Error ? err.message : (isEs ? "Error al procesar el despacho." : "Error processing mail order.");
        modalError.classList.remove("hidden");
      }
    } finally {
      if (modalSubmit) modalSubmit.disabled = false;
      if (modalSpinner) modalSpinner.classList.add("hidden");
      if (modalBtnText) {
        modalBtnText.textContent = isEs
          ? "Despachar Correo Certificado ($29.99)"
          : "Dispatch Certified Mail ($29.99)";
      }
    }
  });

  // ── Event Listeners ──────────────────────────────────────────────────────
  btnNext?.addEventListener("click", () => {
    if (!validateCurrentStep()) return;
    if (currentStep === 3 && !getStoredLead()) {
      openLeadModal();
      return;
    }
    if (currentStep < TOTAL_STEPS) goToStep(currentStep + 1);
  });

  btnBack?.addEventListener("click", () => {
    if (currentStep > 1) goToStep(currentStep - 1);
  });

  btnRestart?.addEventListener("click", () => {
    goToStep(1);
  });

  // Tab buttons click
  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetStep = Number(btn.dataset.gotoStep);
      if (targetStep < currentStep) {
        goToStep(targetStep);
      } else if (targetStep === 4 && !getStoredLead()) {
        if (validateCurrentStep()) openLeadModal();
      } else if (targetStep === currentStep + 1) {
        if (validateCurrentStep()) goToStep(targetStep);
      }
    });
  });

  // Update hints when state changes
  inputState?.addEventListener("change", () => {
    updateStateHint();
    if (currentStep >= 3) runCalculation();
    if (currentStep >= 4) renderDemandLetter();
  });

  // Update on input changes
  inputMoveout?.addEventListener("change", () => {
    if (currentStep >= 3) runCalculation();
    if (currentStep >= 4) renderDemandLetter();
  });
  inputDeposit?.addEventListener("input", () => {
    if (currentStep >= 3) runCalculation();
    if (currentStep >= 4) renderDemandLetter();
  });
  inputReturned?.addEventListener("input", () => {
    if (currentStep >= 3) runCalculation();
    if (currentStep >= 4) renderDemandLetter();
  });

  // Optional inputs on Step 4
  inputTenantName?.addEventListener("input", renderDemandLetter);
  inputLandlordName?.addEventListener("input", renderDemandLetter);
  inputPropertyAddr?.addEventListener("input", renderDemandLetter);

  // Keyboard shortcut: Enter to advance
  wizard?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && (e.target as HTMLElement).tagName !== "TEXTAREA") {
      if (currentStep === 3 && !getStoredLead()) {
        e.preventDefault();
        openLeadModal();
        return;
      }
      if (currentStep < TOTAL_STEPS && validateCurrentStep()) {
        e.preventDefault();
        goToStep(currentStep + 1);
      }
    }
  });

  // ── Auto Pre-fill Saved Lead ─────────────────────────────────────────────
  const initialLead = getStoredLead();
  if (initialLead) {
    if (inputTenantName && !inputTenantName.value) inputTenantName.value = initialLead.name;
    if (mailTenantName && !mailTenantName.value) mailTenantName.value = initialLead.name;
    if (leadNameInput && !leadNameInput.value) leadNameInput.value = initialLead.name;
    if (leadEmailInput && !leadEmailInput.value) leadEmailInput.value = initialLead.email;
  }

  // ── Initial Setup on Mount ───────────────────────────────────────────────
  // 1. Pre-selected state or auto-detect from timezone
  const presetState = wizard?.dataset.defaultState;
  if (presetState && inputState) {
    inputState.value = presetState;
    if (stateDetectedTag) stateDetectedTag.classList.add("hidden");
  } else {
    const detected = autoDetectState();
    if (inputState && detected) {
      inputState.value = detected;
    }
  }
  updateStateHint();

  // 2. Set default move-out date to 30 days ago (standard case)
  const defaultMoveOut = new Date();
  defaultMoveOut.setDate(defaultMoveOut.getDate() - 30);
  const maxDateStr = new Date().toISOString().split("T")[0];
  if (inputMoveout) {
    inputMoveout.max = maxDateStr;
    inputMoveout.value = defaultMoveOut.toISOString().split("T")[0];
  }
</script>
