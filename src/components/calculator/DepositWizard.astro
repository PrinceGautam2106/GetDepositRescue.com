                maxlength="10"
                class="col-span-2 font-mono rounded border border-border bg-card px-3 py-1.5 text-text-primary focus:border-text-primary focus:outline-none"
              />
            </div>
          </div>
        </div>

        <div id="wz-modal-error" class="hidden rounded-md border border-danger/40 bg-danger/10 p-2.5 text-xs text-danger"></div>

        <div class="rounded-lg border border-border bg-canvas-alt p-3 flex items-center justify-between">
          <div>
            <span class="block text-xs font-semibold text-text-primary">{isEs ? "Tarifa Total de Envío Certificado" : "Total Certified Mail Fee"}</span>
            <span class="text-[11px] text-text-muted">{isEs ? "Incluye Acuse de Recibo Electrónico USPS" : "Includes Electronic Return Receipt"}</span>
          </div>
          <span class="text-base font-bold font-mono text-white">$29.99</span>
        </div>

        <button
          id="wz-modal-submit"
          type="button"
          aria-label={isEs ? "Despachar Correo Certificado ($29.99)" : "Dispatch Certified Mail ($29.99)"}
          class="w-full flex items-center justify-center gap-2 rounded-lg bg-cta-bg py-3 text-sm font-semibold text-cta-text hover:bg-cta-hover active:scale-[0.99] transition-all shadow-sm"
        >
          <span id="wz-modal-btn-text">{isEs ? "Despachar Correo Certificado ($29.99)" : "Dispatch Certified Mail ($29.99)"}</span>
          <span id="wz-modal-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-black border-t-transparent"></span>
        </button>
      </div>

      <!-- Screen 2: Tracking & Fulfillment Confirmation Screen -->
      <div id="wz-modal-success-screen" class="hidden mt-4 space-y-4 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-success/20 text-success">
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </div>

        <div>
          <h4 class="text-base font-bold text-text-primary">
            {isEs ? "¡Correo Certificado Despachado con Éxito!" : "Certified Mail Dispatched Successfully!"}
          </h4>
          <p class="text-xs text-text-secondary mt-1">
            {isEs ? "Su carta de demanda formal ha sido enrutada al centro postal de USPS." : "Your formal demand letter has been queued for postal printing and sorting."}
          </p>
        </div>

        <!-- Simulated Barcode Card -->
        <div class="rounded-lg border border-border bg-canvas-alt p-4 font-mono text-left space-y-2">
          <div class="flex justify-between items-center text-[10px] text-text-muted">
            <span>UNITED STATES POSTAL SERVICE</span>
