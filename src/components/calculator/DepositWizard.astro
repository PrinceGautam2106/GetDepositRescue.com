---
/**
 * DepositWizard.astro
 * 4-Step Interactive "Deposit Recovery Calculator" Island.
 *
 * Implements Vercel-inspired minimalist legal-tech design:
 * - Pure black / zinc monochrome palette with emerald-500 accents
 * - Zero layout shift with pre-rendered server structure
 * - Real-time client-side calculation & validation
 * - Instant state statute citations, statutory penalties, and small-claims thresholds
 * - Attorney-grade demand letter live preview & PDF print generation
 * - Certified mail legal proof checkout modal
 * - Bilingual English / Spanish support via i18n dictionary
 */
import { STATE_STATUTES, SUPPORTED_STATE_CODES } from "../../data/stateStatutes";
import { getStrings, type Locale } from "./i18n";
import PartnerOffers from "../monetization/PartnerOffers.astro";

interface Props {
  locale?: Locale;
  defaultState?: string;
}

const { locale = "en", defaultState } = Astro.props;
const t = getStrings(locale);
const isEs = locale === "es";
const activeDefaultState = defaultState ? defaultState.toUpperCase() : "CA";

// Build sorted state list for select dropdown
const stateOptions = SUPPORTED_STATE_CODES
  .map((code) => ({
    code,
    name: STATE_STATUTES[code].stateName[locale],
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<div
  id="deposit-wizard"
  class="relative mx-auto w-full max-w-2xl select-text"
  data-locale={locale}
  data-default-state={defaultState ? defaultState.toUpperCase() : ""}
>
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- Stepper / Progress Header                                                -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <div class="mb-8" aria-label="Calculator Progress">
    <!-- Step tabs -->
    <div class="mb-4 grid grid-cols-4 gap-2">
      {[
        { num: 1, name: t.step1Name },
        { num: 2, name: t.step2Name },
        { num: 3, name: t.step3Name },
        { num: 4, name: t.step4Name },
      ].map((s) => (
        <button
          type="button"
          data-goto-step={s.num}
          aria-label={`${isEs ? "Paso" : "Step"} ${s.num}: ${s.name}`}
          class="wz-tab-btn group flex flex-col items-start gap-1 rounded-md border border-border bg-card p-2 text-left transition-all duration-150 ease-out hover:border-border-hover focus:outline-none focus:ring-1 focus:ring-border-hover disabled:cursor-not-allowed disabled:opacity-50"
        >
          <div class="flex items-center gap-1.5">
            <span class="wz-tab-badge flex h-4 w-4 items-center justify-center rounded-full bg-border text-[10px] font-mono font-bold text-text-muted transition-colors">
              {s.num}
            </span>
            <span class="wz-tab-title hidden text-xs font-medium text-text-secondary group-hover:text-text-primary sm:inline transition-colors">
              {s.name}
            </span>
          </div>
          <div class="h-0.5 w-full rounded-full bg-border transition-colors wz-tab-bar"></div>
        </button>
      ))}
    </div>

    <!-- Step Progress Text -->
    <div class="flex items-center justify-between text-xs text-text-muted">
      <span id="wz-step-label" class="font-medium text-text-secondary">
        {isEs ? "Paso 1 de 4" : "Step 1 of 4"}
      </span>
      <span id="wz-step-pct" class="font-mono text-text-muted">25%</span>
    </div>
  </div>

  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- Step 1: Location & Lease Details                                         -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <section id="wz-step-1" class="wz-step" data-step="1">
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="border-b border-border pb-5">
        <h2 class="text-xl font-semibold tracking-tight text-text-primary">
          {t.step1Title}
        </h2>
        <p class="mt-1 text-sm text-text-secondary">
          {t.step1Subtitle}
        </p>
      </div>

      <div class="mt-6 space-y-6">
        <!-- State Selector -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="wz-state" class="block text-sm font-medium text-text-primary">
              {t.stateLabel}
            </label>
            <span id="wz-state-detected-tag" class="inline-flex items-center gap-1 rounded-full border border-success/30 bg-success/10 px-2 py-0.5 text-[11px] font-medium text-success">
              <span class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
              {t.autoDetectedHint}
            </span>
          </div>
          <div class="relative">
            <select
              id="wz-state"
              aria-label={t.stateLabel}
              class="w-full appearance-none rounded-md border border-border bg-canvas-alt px-3.5 py-2.5 pr-10 text-sm text-text-primary transition-all duration-150 ease-out hover:border-border-hover focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
            >
              <option value="" disabled>
                {t.statePlaceholder}
              </option>
              {stateOptions.map(({ code, name }) => (
                <option value={code} selected={code === activeDefaultState}>
                  {name} ({code})
                </option>
              ))}
            </select>
            <svg
              class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <p id="wz-state-statute-hint" class="mt-2 min-h-[1.25rem] text-xs text-text-muted">
            {isEs
              ? `Plazo legal de ${STATE_STATUTES[activeDefaultState]?.deadlineDays ?? 21} días según ${STATE_STATUTES[activeDefaultState]?.legalCodeCitation ?? "código estatal"}.`
              : `Statutory ${STATE_STATUTES[activeDefaultState]?.deadlineDays ?? 21}-day return deadline under ${STATE_STATUTES[activeDefaultState]?.legalCodeCitation ?? "state statute"}.`}
          </p>
        </div>

        <!-- Move-Out Date Picker -->
        <div>
          <label for="wz-moveout" class="block text-sm font-medium text-text-primary mb-2">
            {t.moveOutLabel}
          </label>
          <div class="relative">
            <input
              type="date"
              id="wz-moveout"
              aria-label={t.moveOutLabel}
              class="w-full rounded-md border border-border bg-canvas-alt px-3.5 py-2.5 text-sm text-text-primary transition-all duration-150 ease-out hover:border-border-hover focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary [color-scheme:dark]"
            />
          </div>
          <p class="mt-2 text-xs text-text-muted">
            {t.moveOutHelp}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- Step 2: Financials & Deductions                                          -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <section id="wz-step-2" class="wz-step hidden" data-step="2">
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="border-b border-border pb-5">
        <h2 class="text-xl font-semibold tracking-tight text-text-primary">
          {t.step2Title}
        </h2>
        <p class="mt-1 text-sm text-text-secondary">
          {t.step2Subtitle}
        </p>
      </div>

      <div class="mt-6 space-y-6">
        <!-- Original Deposit Paid -->
        <div>
          <label for="wz-deposit" class="block text-sm font-medium text-text-primary mb-2">
            {t.depositLabel}
          </label>
          <div class="relative">
            <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-text-muted">
              $
            </span>
            <input
              type="number"
              id="wz-deposit"
              aria-label={t.depositLabel}
              min="0"
              step="any"
              placeholder={t.depositPlaceholder}
              class="w-full rounded-md border border-border bg-canvas-alt py-2.5 pl-8 pr-3.5 font-mono text-sm text-text-primary tabular-nums transition-all duration-150 ease-out hover:border-border-hover focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
            />
          </div>
        </div>

        <!-- Amount Landlord Actually Returned -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="wz-returned" class="block text-sm font-medium text-text-primary">
              {t.returnedLabel}
            </label>
            <span class="text-xs text-text-muted">
              {isEs ? "0 = nada devuelto" : "0 = nothing returned"}
            </span>
          </div>
          <div class="relative">
            <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-text-muted">
              $
            </span>
            <input
              type="number"
              id="wz-returned"
              aria-label={t.returnedLabel}
              min="0"
              step="any"
              value="0"
              placeholder="0"
              class="w-full rounded-md border border-border bg-canvas-alt py-2.5 pl-8 pr-3.5 font-mono text-sm text-text-primary tabular-nums transition-all duration-150 ease-out hover:border-border-hover focus:border-text-primary focus:outline-none focus:ring-1 focus:ring-text-primary"
            />
          </div>
        </div>

        <!-- Deductions Claimed Checkboxes -->
        <fieldset>
          <legend class="block text-sm font-medium text-text-primary mb-2">
            {t.deductionsLabel}
          </legend>
          <p class="mb-3 text-xs text-text-muted">
            {t.deductionsHelp}
          </p>
          <div class="space-y-2.5">
            {[
              {
                id: "painting",
                label: t.deductionPainting,
                desc: isEs ? "Desgaste natural de pintura prohibido por ley" : "Wear-and-tear prohibited from deduction by statute",
                value: "Normal wear and tear",
              },
              {
                id: "carpet",
                label: t.deductionCarpet,
                desc: isEs ? "Uso ordinario de alfombras no es imputable al inquilino" : "Ordinary carpet wear cannot be billed to tenant",
                value: "Routine carpet cleaning",
              },
              {
                id: "cleaning",
                label: t.deductionCleaning,
                desc: isEs ? "Limpieza obligatoria genérica sin prueba de suciedad extrema" : "Mandatory non-itemized turnover cleaning",
                value: "Professional cleaning when unit was left in same condition",
              },
              {
                id: "receipt",
                label: t.deductionNoReceipt,
                desc: isEs ? "Deducciones sin facturas ni recibos de contratistas con licencia" : "Withholdings lacking licensed contractor invoices",
                value: "Deductions without required itemized statement",
              },
            ].map((item) => (
              <label class="group relative flex cursor-pointer items-start gap-3 rounded-lg border border-border bg-canvas-alt p-3.5 transition-all duration-150 ease-out hover:border-border-hover hover:bg-card">
                <input
                  type="checkbox"
                  name="wz-deduction"
                  aria-label={item.label}
                  value={item.value}
                  class="mt-0.5 h-4 w-4 shrink-0 rounded border-border bg-canvas text-success accent-success focus:ring-1 focus:ring-success"
                />
                <div class="flex flex-col">
                  <span class="text-sm font-medium text-text-primary group-hover:text-white transition-colors">
                    {item.label}
                  </span>
                  <span class="text-xs text-text-muted">
                    {item.desc}
                  </span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- Step 3: Instant Violation & Damage Assessment                           -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <section id="wz-step-3" class="wz-step hidden" data-step="3">
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="border-b border-border pb-5">
        <h2 class="text-xl font-semibold tracking-tight text-text-primary">
          {t.step3Title}
        </h2>
        <p class="mt-1 text-sm text-text-secondary">
          {t.step3Subtitle}
        </p>
      </div>

      <!-- Statutory Deadline Violation Badge (flashing bold sapphire) -->
      <div
        id="wz-violation-badge"
        class="mt-6 hidden rounded-lg border-2 border-blue-500/80 bg-blue-950/30 px-4 py-3.5 shadow-[0_0_25px_rgba(59,130,246,0.25)] wz-flash-badge"
      >
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-sky-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <div>
            <p id="wz-violation-text" class="text-sm font-bold text-sky-300 leading-snug">
              <!-- Dynamically populated: Statutory Deadline Violated! Your landlord may owe you up to [3x/2x] your deposit under [State Code]. -->
            </p>
            <p id="wz-violation-subtext" class="mt-1 text-xs text-sky-200/80">
              <!-- Additional state statute info -->
            </p>
          </div>
        </div>
      </div>

      <!-- No Violation Fallback Badge -->
      <div id="wz-no-violation-badge" class="mt-6 hidden rounded-lg border border-border bg-canvas-alt px-4 py-3">
        <p class="text-sm text-text-secondary">
          {t.noViolationBadge}
        </p>
      </div>

      <!-- Timeline & Statutory Days Elapsed Grid -->
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4">
        <div class="rounded-lg border border-border bg-canvas-alt p-4 text-center">
          <p class="text-[11px] font-medium uppercase tracking-wider text-text-muted">
            {t.daysElapsedLabel}
          </p>
          <p id="wz-days-elapsed" class="mt-1 text-3xl font-extrabold font-mono tabular-nums text-text-primary">
            —
          </p>
          <span id="wz-days-status" class="mt-1 inline-block text-[11px] font-mono text-text-muted">
            <!-- elapsed days tag -->
          </span>
        </div>

        <div class="rounded-lg border border-border bg-canvas-alt p-4 text-center">
          <p class="text-[11px] font-medium uppercase tracking-wider text-text-muted">
            {t.deadlineLabel}
          </p>
          <p id="wz-state-deadline" class="mt-1 text-3xl font-extrabold font-mono tabular-nums text-text-primary">
            —
          </p>
          <span id="wz-statute-code-label" class="mt-1 inline-block text-[11px] font-mono text-text-muted truncate max-w-full">
            <!-- state code citation -->
          </span>
        </div>
      </div>

      <!-- Detected Violations Breakdown List -->
      <div id="wz-violations-list" class="mt-6 hidden rounded-lg border border-border bg-canvas-alt p-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">
          {t.violationsDetected}
        </h3>
        <ul id="wz-violations-ul" class="space-y-2"></ul>
      </div>

      <!-- Dynamic Financial Comparison -->
      <div class="mt-6 space-y-3">
        <div class="flex items-center justify-between rounded-lg border border-border bg-canvas-alt px-4 py-3">
          <span class="text-sm text-text-secondary">{t.originalOwed}</span>
          <span id="wz-owed" class="text-sm font-mono font-semibold tabular-nums text-text-primary">
            $0.00
          </span>
        </div>

        <div class="flex items-center justify-between rounded-lg border border-border bg-canvas-alt px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="text-sm text-text-secondary">{t.penaltyEntitlement}</span>
            <span id="wz-multiplier-tag" class="rounded border border-blue-500/30 bg-blue-500/10 px-1.5 py-0.5 text-[10px] font-mono font-semibold text-sky-400">
              +0x
            </span>
          </div>
          <span id="wz-penalty" class="text-sm font-mono font-bold tabular-nums text-sky-400">
            +$0.00
          </span>
        </div>

        <!-- Total Court Recovery Target: Large mono font with Royal Sapphire glowing border -->
        <div class="relative overflow-hidden rounded-xl border border-blue-500/70 bg-gradient-to-b from-[#0f172a] via-[#091124] to-[#020617] p-6 text-center shadow-[0_0_35px_rgba(59,130,246,0.22),inset_0_0_20px_rgba(59,130,246,0.08)]">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.22)_0%,transparent_70%)] pointer-events-none"></div>
          
          <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-widest text-sky-400">
              {t.totalRecovery}
            </p>
            <p id="wz-total" class="mt-2 text-4xl font-black font-mono tracking-tight text-white sm:text-5xl drop-shadow-[0_2px_12px_rgba(56,189,248,0.35)]">
              $0.00
            </p>
            <div class="mt-3 flex items-center justify-center gap-1.5">
              <span id="wz-claims-badge" class="inline-flex items-center gap-1 rounded-full border border-border bg-black/60 px-2.5 py-0.5 text-xs font-medium text-text-secondary">
                <!-- Small claims limit & eligibility -->
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Strategic Affiliate Placements Under Calculation Results -->
      <PartnerOffers locale={locale} variant="grid" headline={isEs ? "Recursos Recomendados Tras Su Cálculo" : "Recommended Resources For Your Next Move"} />
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- Step 4: Demand Letter Generator & Action Bar                             -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <section id="wz-step-4" class="wz-step hidden" data-step="4">
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="border-b border-border pb-5">
        <h2 class="text-xl font-semibold tracking-tight text-text-primary">
          {t.step4Title}
        </h2>
        <p class="mt-1 text-sm text-text-secondary">
          {t.step4Subtitle}
        </p>
      </div>

      <!-- Optional Tenant Details Accordion -->
      <div class="mt-5">
        <details class="group rounded-lg border border-border bg-canvas-alt transition-colors">
          <summary class="flex cursor-pointer items-center justify-between p-3.5 text-xs font-medium text-text-secondary hover:text-text-primary">
            <span>{t.tenantDetailsToggle}</span>
            <svg class="h-4 w-4 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="border-t border-border p-4 space-y-3 text-xs">
            <div>
              <label for="wz-tenant-name" class="block font-medium text-text-primary mb-1">{t.yourNameLabel}</label>
              <input type="text" id="wz-tenant-name" aria-label={t.yourNameLabel} placeholder={t.yourNamePlaceholder} class="w-full rounded-md border border-border bg-card px-3 py-1.5 text-xs text-text-primary focus:border-text-primary focus:outline-none" />
            </div>
            <div>
              <label for="wz-landlord-name" class="block font-medium text-text-primary mb-1">{t.landlordNameLabel}</label>
              <input type="text" id="wz-landlord-name" aria-label={t.landlordNameLabel} placeholder={t.landlordNamePlaceholder} class="w-full rounded-md border border-border bg-card px-3 py-1.5 text-xs text-text-primary focus:border-text-primary focus:outline-none" />
            </div>
            <div>
              <label for="wz-property-addr" class="block font-medium text-text-primary mb-1">{t.propertyAddressLabel}</label>
              <input type="text" id="wz-property-addr" aria-label={t.propertyAddressLabel} placeholder={t.propertyAddressPlaceholder} class="w-full rounded-md border border-border bg-card px-3 py-1.5 text-xs text-text-primary focus:border-text-primary focus:outline-none" />
            </div>
          </div>
        </details>
      </div>

      <!-- Formal Demand Letter Live Preview Card -->
      <div class="mt-6 rounded-lg border border-border bg-canvas-alt p-5 sm:p-7 shadow-inner">
        <div class="mb-4 flex items-center justify-between border-b border-border pb-3">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-success"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-text-primary">
              {t.demandLetterPreview}
            </span>
          </div>
          <span class="rounded border border-border bg-card px-2 py-0.5 text-[10px] font-mono text-text-muted">
            USPS Certified Format
          </span>
        </div>

        <!-- Rendered Letter Body -->
        <div
          id="wz-letter-preview"
          class="space-y-4 text-xs sm:text-sm font-sans leading-relaxed text-text-secondary select-text"
        >
          <!-- Populated in client script with live data and legal citations -->
        </div>
      </div>

      <!-- ═════════════════════════════════════════════════════════════════ -->
      <!-- Dual Monetization Checkout Tiers ($14.99 PDF vs $29.99 USPS Mail) -->
      <!-- ═════════════════════════════════════════════════════════════════ -->
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Card A (Digital Download - $14.99) -->
        <div class="relative flex flex-col justify-between rounded-xl border border-border bg-card p-5 sm:p-6 transition-all duration-150 hover:border-zinc-500">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase tracking-wider text-text-muted">
                {isEs ? "Descarga Digital" : "Digital Download"}
              </span>
            </div>
            <h3 class="mt-2 text-lg font-bold text-text-primary">
              {isEs ? "Paquete Legal PDF Oficial" : "Official Legal PDF Package"}
            </h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="text-3xl font-extrabold font-mono text-white">$14.99</span>
              <span class="text-xs text-text-muted">{isEs ? "pago único" : "one-time"}</span>
            </div>

            <!-- Features -->
            <ul class="mt-4 space-y-2.5 text-xs text-text-secondary border-t border-border pt-4">
              <li class="flex items-start gap-2">
                <svg class="h-4 w-4 text-sky-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span>{isEs ? "Descarga inmediata en PDF" : "Instant PDF download"}</span>
              </li>
              <li class="flex items-start gap-2">
