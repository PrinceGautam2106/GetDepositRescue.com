      <button
        id="wz-lead-modal-close"
        type="button"
        aria-label={isEs ? "Cerrar modal" : "Close lead modal"}
        class="absolute right-4 top-4 rounded-lg p-1 text-text-muted hover:text-text-primary hover:bg-zinc-800/60 focus:outline-none transition-colors"
      >
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
        </svg>
      </button>

      <!-- Badge & Icon -->
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 px-2.5 py-0.5 text-xs font-mono font-medium text-sky-400">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          {isEs ? "Evaluación Completada" : "Penalty Audit Ready"}
        </span>
      </div>

      <!-- Headline -->
      <h3 id="wz-lead-modal-title" class="text-lg sm:text-xl font-bold tracking-tight text-white leading-snug">
        {isEs
          ? "¿A dónde debemos enviar por correo su desglose de sanciones y carta de demanda?"
          : "Where should we email your statutory penalty breakdown & demand letter?"}
      </h3>

      <p class="mt-2 text-xs sm:text-sm text-text-secondary leading-relaxed">
        {isEs
          ? "Guarde su cálculo legal y desbloquee inmediatamente la carta oficial de demanda lista para enviar a su arrendador."
          : "Save your audit calculations and unlock your official demand letter pre-filled with state statutory citations."}
      </p>

      <!-- Form Inputs -->
      <div class="mt-5 space-y-3.5">
        <div>
          <label for="wz-lead-name" class="block text-xs font-medium text-text-primary mb-1.5">
            {isEs ? "Su Nombre Completo" : "Your Full Legal Name"}
          </label>
          <input
            type="text"
            id="wz-lead-name"
            aria-label={isEs ? "Su Nombre Completo" : "Your Full Legal Name"}
            placeholder={isEs ? "ej. Juan Pérez" : "e.g. Jane Doe"}
            class="w-full rounded-lg border border-border bg-card px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-colors"
          />
        </div>

        <div>
          <label for="wz-lead-email" class="block text-xs font-medium text-text-primary mb-1.5">
            {isEs ? "Correo Electrónico" : "Email Address"}
          </label>
          <input
            type="email"
            id="wz-lead-email"
            aria-label={isEs ? "Correo Electrónico" : "Email Address"}
            placeholder={isEs ? "tu@correo.com" : "you@example.com"}
            class="w-full rounded-lg border border-border bg-card px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-colors"
          />
        </div>

        <!-- Error Feedback -->
        <div id="wz-lead-error" class="hidden rounded-md border border-danger/40 bg-danger/10 p-2.5 text-xs text-danger font-medium"></div>

        <!-- Submit Button -->
        <button
          id="wz-lead-submit"
          type="button"
          class="w-full mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 py-3 text-sm font-bold text-white active:scale-[0.99] transition-all shadow-lg shadow-blue-500/25 focus:outline-none focus:ring-2 focus:ring-blue-400"
        >
          <span id="wz-lead-btn-text">
            {isEs ? "Desbloquear Carta de Demanda" : "Unlock Official Demand Letter"}
          </span>
          <span id="wz-lead-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Secondary Reassurance (as requested) -->
        <div class="flex items-center justify-center gap-1.5 pt-1 text-xs text-text-muted">
          <svg class="h-3.5 w-3.5 text-sky-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
          <span>{isEs ? "Respetamos su privacidad. Cero spam." : "We respect your privacy. No spam."}</span>
        </div>
      </div>
    </div>
  </div>

