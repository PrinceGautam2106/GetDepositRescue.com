  <div
    id="wz-lead-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="wz-lead-modal-title"
  >
    <div class="relative w-full max-w-md rounded-2xl border border-zinc-800 bg-[#0c0c0e] p-6 shadow-2xl sm:p-8 text-left animate-in fade-in zoom-in-95 duration-150">
