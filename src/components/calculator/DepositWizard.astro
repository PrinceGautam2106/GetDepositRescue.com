            ||||| | |||| || |||||| | ||||| ||| ||||
          </div>

          <div class="border-t border-border pt-2 space-y-1 text-xs">
            <div class="flex justify-between">
              <span class="text-text-muted">{isEs ? "Número de Rastreo" : "Tracking Number"}:</span>
              <span id="wz-confirmed-tracking" class="font-bold text-sky-400">7023 0490 0001 8492 4192</span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-muted">{isEs ? "Entrega Estimada" : "Estimated Delivery"}:</span>
              <span id="wz-confirmed-delivery" class="text-text-primary font-medium">—</span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-muted">{isEs ? "ID de Orden" : "Order ID"}:</span>
              <span id="wz-confirmed-order-id" class="text-text-muted font-mono text-[11px]">—</span>
