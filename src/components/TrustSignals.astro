---
/**
 * TrustSignals.astro
 * Google E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness)
 * Methodology and Verification Grid for US Landlord-Tenant Deposit Recovery.
 */

interface Props {
  locale?: "en" | "es";
  class?: string;
}

const { locale = "en", class: className = "" } = Astro.props;
const isEs = locale === "es";

const trustPoints = [
  {
    num: "01",
    title: isEs ? "Citaciones Directas de Leyes Estatales" : "Direct State Statute Citations",
    badge: isEs ? "Códigos Civiles Oficiales" : "Official Civil Codes",
    badgeColor: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    description: isEs
      ? "Nuestros cálculos y cláusulas de cartas citan directamente los códigos civiles y estatutos de propiedad oficiales de cada estado (ej. Cal. Civ. Code § 1950.5, Tex. Prop. Code § 92.109, NY GOL § 7-108), auditados para cumplimiento legal en 2026."
      : "Every penalty calculation and demand clause directly cites official state civil codes and property statutes (e.g. Cal. Civ. Code § 1950.5, Tex. Prop. Code § 92.109, NY GOL § 7-108), continuously audited for 2026 statutory compliance.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />`,
  },
  {
    num: "02",
    title: isEs ? "Estándares Admisibles en Tribunales" : "Court-Admissible Standards",
    badge: isEs ? "Prueba Probatoria USPS" : "USPS Evidentiary Proof",
    badgeColor: "border-blue-500/30 bg-blue-500/10 text-blue-400",
    description: isEs
      ? "El envío por Correo Certificado USPS con acuse de recibo electrónico proporciona un registro postal verificable que satisface la carga de la prueba en la corte de reclamos menores, impidiendo que el arrendador alegue falta de notificación."
      : "USPS Certified Mail tracking with Electronic Return Receipt establishes an irrefutable legal paper trail, satisfying small claims court pre-filing notice standards and judicial burden of proof.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />`,
  },
  {
    num: "03",
    title: isEs ? "Enfoque en Derechos del Consumidor" : "Consumer Rights Focused",
    badge: isEs ? "Cero Sesgo Inmobiliario" : "No Landlord Bias",
    badgeColor: "border-purple-500/30 bg-purple-500/10 text-purple-400",
    description: isEs
      ? "Desarrollado exclusivamente para defender a inquilinos frente a abusos. Nuestras fórmulas algorítmicas son completamente independientes, aplican plazos perentorios y detectan automáticamente deducciones ilegales por desgaste ordinario."
      : "Independent calculation formulas designed solely for tenant defense. Automated audit algorithms flag non-deductible wear and tear, enforce statutory return deadlines, and maximize statutory damages with zero landlord bias.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v18m-9-6 3 5h6l3-5m-9-6 3-5h6l3 5m-9 6a3 3 0 0 1-3 0m15 0a3 3 0 0 1-3 0" />`,
  },
];
---

<section
  class={`rounded-2xl border border-border bg-card p-6 sm:p-8 lg:p-10 ${className}`}
  aria-labelledby="trust-signals-heading"
>
  <div class="max-w-2xl">
    <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-canvas px-3 py-1 text-xs font-mono font-medium text-text-secondary">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
      {isEs ? "Metodología y Verificación E-E-A-T" : "E-E-A-T Trust & Methodology"}
    </div>
    <h2
      id="trust-signals-heading"
      class="mt-3 text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-text-primary"
    >
      {isEs ? "Rigor Legal Respaldado por Estatutos de EE. UU." : "Statutory Authority Built for Tenant Protection"}
    </h2>
    <p class="mt-2 text-xs sm:text-sm text-text-secondary leading-relaxed">
      {isEs
        ? "Diseñado bajo los más altos estándares de rigor jurídico y tecnológico para que cualquier inquilino recupere su depósito sin intermediarios costosos."
        : "Engineered with legal-tech precision, authoritative statutory data, and court-tested evidentiary standards so tenants can reclaim withheld funds with confidence."}
    </p>
  </div>

  <!-- 3-Point Trust Grid -->
  <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
    {trustPoints.map((point) => (
      <div class="group relative flex flex-col justify-between rounded-xl border border-border bg-canvas-alt p-5 sm:p-6 transition-all duration-150 ease-out hover:border-zinc-700 hover:bg-[#151519]">
        <div>
          <!-- Header: Number & Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-xs font-semibold text-text-muted">
              {point.num}
            </span>
            <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-mono font-medium ${point.badgeColor}`}>
              {point.badge}
            </span>
          </div>

          <!-- Icon & Title -->
          <div class="flex items-center gap-2.5 mb-2.5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border bg-card text-text-primary group-hover:text-emerald-400 group-hover:border-zinc-600 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="h-4.5 w-4.5"
                set:html={point.icon}
              />
            </div>
            <h3 class="text-sm font-semibold tracking-tight text-text-primary group-hover:text-white transition-colors">
              {point.title}
            </h3>
          </div>

          <!-- Description -->
          <p class="mt-3 text-xs leading-relaxed text-text-secondary">
            {point.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-border/50 flex items-center gap-1.5 text-[11px] font-mono text-text-muted">
          <span class="inline-block h-1 w-1 rounded-full bg-emerald-400"></span>
          <span>{isEs ? "Verificado 2026" : "Audited 2026"}</span>
        </div>
      </div>
    ))}
  </div>
</section>
